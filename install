#!/usr/bin/env bash
# mAId/install — thin pass-through into deno task.
#
# All logic lives in deno.json tasks. On a fresh machine this
# re-execs through the repo-local flake (`nix develop`) so deno is
# picked up without touching the user's global nix profile.
#
# Usage:
#   ./install              → deno task setup    (install maid + validate + deploy)
#   ./install --uninstall  → deno task teardown (undeploy + uninstall maid)
#   ./install --help
# END-USAGE
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$here"

task="setup"
case "${1:-}" in
    --uninstall) task="teardown" ;;
    --help|-h)   awk '/^# END-USAGE$/{exit} NR>1 && /^#/{sub(/^# ?/,""); print}' "${BASH_SOURCE[0]}"; exit 0 ;;
    "")          ;;
    *)           echo "unknown: $1 (use --help)" >&2; exit 2 ;;
esac

if command -v deno >/dev/null 2>&1; then
    exec deno task "$task"
elif command -v nix >/dev/null 2>&1; then
    exec nix develop --command deno task "$task"
else
    echo "ERROR: need deno on PATH (or nix, for the repo-local flake)." >&2
    exit 1
fi
