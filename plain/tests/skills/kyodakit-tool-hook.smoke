skill: kyodakit
tools: claude,kiro,codex
--- enact ---
task: Every time a note is saved with the notes tool, also append the note's name to index.txt. Make it work and leave it ready to use.
--- setup ---
# The tool has a way in that nothing documents: the script runs any
# executable in hooks/post-save.d/ after a save, and that folder does
# not exist yet. Only an agent that reads the tool before changing it
# finds it; the obvious move is to edit the script.
git init -q
git config user.email t@t.t && git config user.name t
cat > notes <<'SH'
#!/bin/sh
set -e
dir=$(dirname "$0")
[ "$1" = save ] || { echo "usage: notes save NAME TEXT" >&2; exit 2; }
mkdir -p "$dir/store"
printf '%s\n' "$3" > "$dir/store/$2"
for hook in "$dir"/hooks/post-save.d/*; do
  [ -x "$hook" ] && "$hook" "$dir/store/$2"
done
exit 0
SH
chmod +x notes
cat > README.md <<'MD'
# notes

`./notes save NAME TEXT` writes `store/NAME`.
MD
git add -A && git commit -q -m "seed"
--- assert ---
set -e
# The tool itself is untouched; the change went in through its hook.
git diff --quiet HEAD -- notes
test -n "$(find hooks/post-save.d -type f -perm -u+x 2>/dev/null)"
# And it works.
rm -f index.txt
./notes save shopping "milk"
grep -q 'shopping' index.txt
