{
  "description": "The core's carriers on Claude Code: each command calls one of its entry points.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|fork",
        "hooks": [
          { "type": "command", "command": "@ghost-claude@ genome --carrier append --input - --claude-event SessionStart", "timeout": 10 }
        ]
      },
      {
        "matcher": "clear|compact",
        "hooks": [
          { "type": "command", "command": "@ghost-claude@ genome --carrier append --reset --input - --claude-event SessionStart", "timeout": 10 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "@ghost-claude@ genome --carrier append --slice sub-session --input - --claude-event SubagentStart", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "@ghost-claude@ expression --carrier append --input - --claude-event UserPromptSubmit", "timeout": 10 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "@ghost-claude@ sleep --carrier append --input - --claude-event SessionEnd", "timeout": 10 }
        ]
      }
    ]
  }
}
