#!/usr/bin/env bash
# Free test of both installs: plain's (`just install`, `just rollback`, the
# generations install keeps, and a profile dir without nix) and the
# ghost's over it (`just ghost install|on|off|status|rollback|uninstall`),
# against the real claude and codex CLIs in a temp HOME and temp profiles.
# No model calls. Needs nix and both CLIs; from the checkout:
#
#   nix develop -c ghost-in-shell/tests/rollback
#
# The installs from the clone run its committed recipes; everything else
# runs this checkout's working tree. Builds run with the real HOME, so nix finds its config and
# cache; everything that touches an agent runs with the temp one.
set -uo pipefail

here=$(git rev-parse --show-toplevel)
cd "$here" || exit 1
work=$(mktemp -d)
# The pre-plugin tree is copied from the store, so it is read-only.
trap 'chmod -R u+w "$work"; rm -rf "$work"' EXIT
th=$work/home
mkdir -p "$th" "$work/state/maid"
export MAID_PROFILE=$work/state/maid/profile GHOST_PROFILE=$work/state/maid/ghost/profile
export CARGO_HOME=${CARGO_HOME:-$HOME/.cargo} CARGO_TARGET_DIR=$here/target
# nix keeps its settings and fetch cache under these; the agents do not.
export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config} XDG_CACHE_HOME=${XDG_CACHE_HOME:-$HOME/.cache}
unset CODEX_HOME CLAUDE_CONFIG_DIR XDG_STATE_HOME MY_HARNESS_STATE MY_HARNESS_PARTS INSTALL_RECORDS
# XDG_CONFIG_HOME stays real for nix, so mAId's config dir must not.
export MAID_CONFIG=$work/config/maid MAID_MEMORY_STORE=$work/config/maid/memory-store
# A personal store, so install registers and records the memory server.
store=$work/store
mkdir -p "$store" "$MAID_CONFIG"
echo "$store" >"$MAID_MEMORY_STORE"

fails=0
check() {
  local what=$1
  shift
  if "$@"; then echo "PASS  $what"; else echo "FAIL  $what"; fails=$((fails + 1)); fi
}
inhome() { HOME=$th "$@"; }
gen() { readlink "$MAID_PROFILE" | sed -n 's/.*-\([0-9]*\)-link$/\1/p'; }
version_of() { jq -r .version "$1/share/maid/marketplace/plugins/maid/.codex-plugin/plugin.json"; }
listed() {
  case $1 in
    claude) inhome claude plugin list --json 2>/dev/null | jq -r '.[] | select(.id == "maid@maid" and .scope == "user") | .version' ;;
    codex) inhome codex plugin list --json 2>/dev/null | jq -r '.installed[]? | select(.pluginId == "maid@maid") | .version' ;;
  esac
}
both_at() { [ "$(listed claude)" = "$1" ] && [ "$(listed codex)" = "$1" ]; }
codex_has_marker() { grep -rqs "$marker" "$th/.codex/plugins/cache"; }
kiro_has_marker() { grep -qs "$marker" "$th/.kiro/skills/notes/SKILL.md"; }
skills() { inhome just plain::install-skills >"$work/log" 2>&1 || { cat "$work/log"; return 1; }; }
rollback() { inhome just rollback >"$work/out" 2>&1; }
partlist=$th/.local/state/install-records/maid.json
oldlist=$th/.local/state/my-harness/parts/maid-harness.json
# The entries one agent has in mAId's install record, one `kind name [skipped]` per line.
entries() { jq -r --arg h "$1" '.agents[$h][]? | "\(.kind) \(.name)\(if .skipped then " skipped" else "" end)"' "$partlist" 2>/dev/null; }
# mAId's claude entry named $1.
claude_entry() { jq -e --arg n "$1" '.agents.claude[] | select(.name == $n)' "$partlist"; }
mcp_entry() { entries "$1" | grep -qx "mcp chrome-devtools\( skipped\)\?"; }

# Three installs: one older than the plugin marketplace (C), this
# checkout (A), and a clone with one skill line added (B).
echo "building..."
A=$(nix build --no-link --print-out-paths "$here#default") || exit 1
git clone -q "$here" "$work/b"
marker="rollback-test marker $RANDOM$RANDOM"
echo "$marker" >>"$work/b/resources/skills/notes/SKILL.md"
B=$(nix build --no-link --print-out-paths "$work/b#default" 2>/dev/null) || exit 1
mkdir -p "$work/c/share/maid/skills"
cp -rL "$A/share/maid/skills/notes" "$work/c/share/maid/skills/"
C=$(nix store add-path --name maid-before-plugins "$work/c") || exit 1
# The profile is addressed by its content: a commit that changes no
# installed file builds the same store path.
git clone -q "$here" "$work/d"
D1=$(nix build --no-link --print-out-paths "$work/d#default" "$work/d#ghost" 2>/dev/null) || exit 1
echo "spec-only change" >>"$work/d/specs/project.md"
git -C "$work/d" -c user.name=t -c user.email=t@example.org commit -qam "docs: spec only"
D2=$(nix build --no-link --print-out-paths "$work/d#default" "$work/d#ghost" 2>/dev/null) || exit 1
check "a spec-only commit builds the same store path for plain and for the ghost" test "$D1" = "$D2"
vA=$(version_of "$A")
vB=$(version_of "$B")

nix build --profile "$MAID_PROFILE" "$C" || exit 1
nix build --profile "$MAID_PROFILE" "$A" && skills || exit 1
nix build --profile "$MAID_PROFILE" "$B" && skills || exit 1
check "second install is live in claude, codex and kiro" \
  eval 'both_at "$vB" && codex_has_marker && kiro_has_marker'

inhome just plain::install-browser-mcp >"$work/log" 2>&1 || { cat "$work/log"; exit 1; }
placed_on_all() {
  for h in claude codex; do
    entries $h | grep -qx "plugin maid@maid" && entries $h | grep -qx "marketplace maid" && mcp_entry $h || return 1
  done
  entries kiro-cli | grep -qx "skill notes" && mcp_entry kiro-cli
}
check "the install record names what install placed on claude, codex and kiro" placed_on_all
grant=$MAID_PROFILE/share/maid/marketplace/plugins/maid
granted() { jq -e --arg d "$grant" '.permissions.additionalDirectories | index($d)' "$th/.claude/settings.json" >/dev/null 2>&1; }
check "install lets claude read mAId's plugin dir, and records it" \
  eval 'granted && entries claude | grep -qx "setting permissions.additionalDirectories"'
edit_rule="Edit(/$MAID_CONFIG/writing-style/**)"
writable() { jq -e --arg r "$edit_rule" '.permissions.allow | index($r)' "$th/.claude/settings.json" >/dev/null 2>&1; }
check "install lets claude read and write writing-style's state dir, and records it" \
  eval 'writable && entries claude | grep -qx "setting permissions.allow"'
vendor=anthropic-agent-skills
brought_in() {
  for h in claude codex; do
    entries $h | grep -qx "marketplace $vendor" && entries $h | grep -qx "plugin document-skills@$vendor" || return 1
  done
  entries kiro-cli | grep -qx "marketplace $vendor skipped"
}
check "the install record names the vendor marketplace placed on claude and codex, skipped on kiro" brought_in

pin=$(jq -r .nodes.pensieve.locked.rev "$here/flake.lock")
memory_source() {
  claude_entry personal-memory | jq -e --arg pin "$pin" --arg at "$MAID_PROFILE/share/maid/servers/personal-memory" '
    .source.repo == "https://github.com/kusimari/pensieve" and .source.rev == $pin
      and .at == $at and .values.index == "memory/MEMORY.md"' >/dev/null
}
check "the install record records the memory's source as its package at the flake's pin" memory_source
# The memory's serve value is the command install registers on claude.
serve_bound() {
  claude_entry personal-memory | jq -e --arg p "$MAID_PROFILE/bin/pensieve" --arg s "$store" '
    .values.serve | fromjson == [$p, "--store", $s]' >/dev/null
}
check "the install record binds the memory's serve to the profile's pensieve on the store" serve_bound
# Install runs from this checkout, so it records this checkout's revision,
# marked dirty when the tree has changes.
rev=$(git -C "$here" rev-parse HEAD)
[ -z "$(git -C "$here" status --porcelain --untracked-files=no)" ] || rev=$rev-dirty
recorded_package() {
  jq -e --arg rev "$rev" --arg root "$MAID_PROFILE/share/maid" '
    .package == "maid" and .source.rev == $rev and .root == $root and (.installed | test("^[0-9]{4}-"))
      and ([.. | objects | keys[]] | any(. == "persona" or . == "bring_ins" or . == "tenure" or . == "extensions") | not)' "$partlist" >/dev/null &&
    claude_entry "document-skills@$vendor" | jq -e '.source.repo == "https://github.com/anthropics/skills.git"' >/dev/null
}
check "the install record holds mAId's revision and no ghost fact" recorded_package
plain_plugin=$MAID_PROFILE/share/maid/marketplace/plugins/maid
plain_only() {
  [ ! -e "$MAID_PROFILE/bin/ghost-claude" ] && [ ! -e "$plain_plugin/hooks" ] &&
    [ ! -e "$plain_plugin/skills/reflect" ] && [ ! -e "$plain_plugin/agents" ] &&
    jq -e 'has("extensions") or has("hooks") or has("mcpServers") | not' "$plain_plugin/.claude-plugin/plugin.json" >/dev/null &&
    inhome claude plugin validate --strict "$plain_plugin" >"$work/validate" 2>&1
}
check "plain's package has nothing of the ghost and passes strict validation" plain_only
# An install over an old maid-harness.json takes its entries as its own
# (nothing adopted anew, nothing placed again), and leaves no old file.
migrated() {
  mkdir -p "$(dirname "$oldlist")"
  jq '{format, part: "maid-harness", persona: "personal", harnesses: .agents,
       bring_ins: [{name: "document-skills", tenure: {kind: "borrowed", from: "x", since: "2026-10-31"}}]}' \
    "$partlist" >"$oldlist" && rm "$partlist" &&
    jq -S '.harnesses | map_values(map({kind, name, skipped, adopted}))' "$oldlist" >"$work/old-entries" &&
    v=$(listed claude) &&
    skills && inhome just plain::install-browser-mcp >"$work/log" 2>&1 &&
    [ ! -e "$oldlist" ] && [ "$(listed claude)" = "$v" ] &&
    jq -S '.agents | map_values(map({kind, name, skipped, adopted}))' "$partlist" >"$work/new-entries" &&
    diff "$work/old-entries" "$work/new-entries" >/dev/null &&
    jq -e '.installed == "2026-10-31"' "$partlist" >/dev/null
}
check "an install migrates an old maid-harness.json: same entries, nothing placed again, the old file gone" migrated

# Whole-status reads each harness's own listing: everything mAId placed is
# there, and a second part's list beside mAId's is checked the same way.
whole() { inhome just status --whole "$@" >"$work/whole" 2>/dev/null; }
shows() { grep -qx "    present        $1" "$work/whole"; }
maid_whole() {
  whole || return 1
  for h in claude codex; do
    whole $h && shows "plugin maid@maid" && shows "marketplace maid" || return 1
  done
  for h in kiro agy; do whole $h && shows "skill notes" || return 1; done
}
check "status --whole finds what mAId placed on each harness" maid_whole
vendor_whole() {
  for h in claude codex; do
    whole $h && shows "marketplace $vendor" && shows "plugin document-skills@$vendor" || return 1
  done
}
check "status --whole finds the vendor marketplace and plugin on claude and codex" vendor_whole
other=$(dirname "$partlist")/other.json
echo '{"format":1,"package":"other","agents":{"claude":[{"kind":"marketplace","name":"maid"},{"kind":"plugin","name":"absent@nowhere"}]}}' >"$other"
whole
rc=$?
check "status --whole reports a second package beside mAId's and fails on what it lacks" \
  eval '[ $rc != 0 ] && grep -qx "  other" "$work/whole" && grep -qx "  maid" "$work/whole" && grep -qx "    missing        plugin absent@nowhere" "$work/whole"'
rm "$other"
check "removing that manifest leaves mAId whole" maid_whole

rollback
rc=$?
check "rollback returns claude, codex and kiro to the first install" \
  eval '[ $rc = 0 ] && [ "$(gen)" = 2 ] && both_at "$vA" && ! codex_has_marker && ! kiro_has_marker'

# An install whose build fails leaves the generation rolled back from.
git clone -q "$here" "$work/broken"
echo 'not nix' >>"$work/broken/flake.nix"
just -f "$work/broken/Justfile" plain::install-profile >"$work/log" 2>&1
rc=$?
check "an install that fails to build keeps the generations it would drop" \
  eval '[ $rc != 0 ] && [ "$(gen)" = 2 ] && [ -e "$MAID_PROFILE-3-link" ]'

# A third install (D, the clone edited again), from the clone's recipes,
# then roll back: back on A, not on B, which the first rollback left above.
echo "second $marker" >>"$work/b/resources/skills/notes/SKILL.md"
just -f "$work/b/Justfile" plain::install-profile >"$work/log" 2>&1 && skills || exit 1
vD=$(version_of "$(readlink -f "$MAID_PROFILE")")
check "install after a rollback drops the generation rolled back from" \
  eval '[ "$(gen)" = 3 ] && [ ! -e "$MAID_PROFILE-4-link" ] && both_at "$vD"'
rollback
rc=$?
check "rollback after rollback-then-install returns to the install before it" \
  eval '[ $rc = 0 ] && [ "$(gen)" = 2 ] && both_at "$vA"'

rollback
rc=$?
check "rollback to an install the agents cannot take is refused" \
  eval '[ $rc != 0 ] && [ "$(gen)" = 2 ] && both_at "$vA" && grep -q "staying on generation 2" "$work/out"'

nix profile wipe-history --profile "$MAID_PROFILE" 2>/dev/null
rollback
rc=$?
check "rollback with no earlier install changes nothing" \
  eval '[ $rc != 0 ] && [ "$(gen)" = 2 ] && both_at "$vA" && grep -q "no install before generation 2" "$work/out"'

# The 30-day cleanup: live on D, both generations dated 40 days back,
# then an install of A. D, the install before it, must be kept.
just -f "$work/b/Justfile" plain::install-profile >"$work/log" 2>&1 && skills || exit 1
touch -h -d '40 days ago' "$MAID_PROFILE"-*-link
just plain::install-profile >"$work/log" 2>&1 && skills || exit 1
rollback
rc=$?
check "cleanup of old installs keeps the one before the live one" \
  eval '[ $rc = 0 ] && [ ! -e "$MAID_PROFILE-2-link" ] && [ "$(gen)" = 3 ] && both_at "$vD"'

# An unchanged reinstall while everything is old adds no generation, so
# it must not wipe: the install before the live one would go.
just plain::install-profile >"$work/log" 2>&1 && skills || exit 1
touch -h -d '40 days ago' "$MAID_PROFILE"-*-link
just plain::install-profile >"$work/log" 2>&1 || exit 1
check "an unchanged install keeps the install before the live one" \
  eval '[ "$(gen)" = 4 ] && [ -e "$MAID_PROFILE-3-link" ]'

# A link mAId did not write makes install exit non-zero; rollback still
# moves every agent, keeps the link, and passes the exit code on.
just plain::install-profile >"$work/log" 2>&1 && skills || exit 1
mkdir -p "$work/elsewhere"
ln -sfn "$work/elsewhere" "$th/.gemini/config/skills"
rollback
rc=$?
check "rollback past a link mAId did not write still moves the agents" \
  eval '[ $rc != 0 ] && [ "$(gen)" = 3 ] && both_at "$vD" && [ "$(readlink "$th/.gemini/config/skills")" = "$work/elsewhere" ]'
check "the install record names agy's skills as skipped past that link" \
  eval 'entries agy | grep -qx "skill notes skipped"'

# ── the ghost, over plain ───────────────────────────────────────────
ghost() { inhome just ghost "$@" >"$work/g" 2>&1; }
gprofile=$GHOST_PROFILE
grecord=$th/.local/state/install-records/ghost.json
glisted() { inhome claude plugin list --json 2>/dev/null | jq -r '.[] | select(.id == "ghost@ghost-in-shell" and .scope == "user") | "\(.version) \(.enabled)"'; }
gversion() { jq -r .version "$gprofile/share/ghost/marketplace/plugins/ghost/.claude-plugin/plugin.json"; }
ggen() { readlink "$gprofile" | sed -n 's/.*-\([0-9]*\)-link$/\1/p'; }
# Plain is live from the clone (D), so the ghost says so and installs plain
# from this checkout first. agy's skills dir is mAId's again.
rm -f "$th/.gemini/config/skills"
ghost install
rc=$?
check "ghost over plain from another revision says why and installs plain from this checkout" \
  eval '[ $rc = 0 ] && grep -q "mAId.s plugin is at $vD, this checkout.s is $vA; installing the resources from this checkout" "$work/g" && both_at "$vA"'
check "the ghost's plugin is listed, enabled, at its profile's version" eval '[ "$(glisted)" = "$(gversion) true" ]'
check "the ghost writes its own install record, with plain's version it was installed with" \
  eval 'jq -e --arg v "$vA" ".package == \"ghost\" and (.agents.claude[] | select(.name == \"ghost@ghost-in-shell\") | .values.plain == \$v)" "$grecord" >/dev/null'
gplugin=$gprofile/share/ghost/marketplace/plugins/ghost
ghost_carriers() {
  core=$(readlink -f "$gprofile")/bin/ghost-claude &&
    jq -e --arg core "$core" '[.hooks[][].hooks[].command | split(" ")[0]] | length > 0 and all(. == $core)' \
      "$gplugin/hooks/hooks.json" >/dev/null &&
    jq -e --arg core "$core" '.mcpServers["my-harness"].command == $core' "$gplugin/.mcp.json" >/dev/null &&
    cmd=$(jq -r '.hooks.SessionStart[] | select(.matcher | split("|") | index("startup")) | .hooks[0].command' \
      "$gplugin/hooks/hooks.json") &&
    echo '{"session_id":"rollback-probe","cwd":"/","source":"startup"}' |
      env -i HOME="$th" sh -c "$cmd" >"$work/hook" &&
    jq -e '.hookSpecificOutput.additionalContext | startswith("personas: personal")' "$work/hook" >/dev/null
}
check "the ghost's hooks and MCP server call its profile's binary, and a start hook answers" ghost_carriers
core_bare() {
  env -i HOME="$th" "$gprofile/bin/ghost-claude" genome >"$work/genome" 2>&1 &&
    grep -qE '^personas: personal \(mAId\)(, |$)' "$work/genome" &&
    grep -q '^  notes: ' "$work/genome" &&
    grep -q 'document-skills: .*borrowed from anthropic-agent-skills' "$work/genome"
}
check "the ghost's binary shows mAId's persona and bring-ins under a bare environment" core_bare
session_bring_ins() {
  sed -n '/^session bring-ins:/,/^turn bring-ins:/p' "$work/genome" >"$work/session"
  grep -qx "  personal-memory: .* \[personal, own\]; state: $store" "$work/session" &&
    grep -q '^  claude-adapter: .*\[personal, own\]$' "$work/session" &&
    ! grep -q 'undeclared: .*personal-memory' "$work/genome"
}
check "the genome lists the declared memory with its store, and the adapter as [personal, own]" session_bring_ins
by_hand() {
  mkdir -p "$th/.claude/skills/garden"
  printf -- '---\nname: garden\ndescription: d\nmetadata:\n  my-harness.contract: "1"\n  my-harness.repository: https://example.org/me/garden\n  my-harness.scope: turn\n  my-harness.job: tend the garden\n---\n' \
    >"$th/.claude/skills/garden/SKILL.md"
  env -i HOME="$th" "$gprofile/bin/ghost-claude" genome >"$work/hand" 2>&1
  rm -r "$th/.claude/skills/garden"
  grep -q '^  garden: tend the garden \[garden, own\]$' "$work/hand" && ! grep -q garden "$partlist"
}
check "a skill installed by hand joins the ghost by its declaration" by_hand
# Every bring-in mAId installs declares the contract; writing-style's tiers
# are optional, so it is ready before any rule is written.
declared() {
  env -i HOME="$th" "$gprofile/bin/ghost-claude" environment --json >"$work/env" 2>&1 &&
    jq -e '[.[] | select(.part == "mAId")] as $m
      | ([$m[] | select(.readiness.is == "undeclared" or .readiness.is == "unreadable")] | length) == 0
      and (["browser", "kdevkit", "kreviewkit", "kyodakit", "notes", "writing-style", "document-skills"]
        | all(. as $n | any($m[]; .name == $n)))
      and ($m[] | select(.name == "writing-style") | .readiness.is == "ready")' "$work/env" >/dev/null &&
    [ ! -e "$MAID_CONFIG/writing-style/learned.md" ]
}
check "every mAId bring-in is declared, and writing-style is ready with no rules file" declared
reflection_ships() {
  [ -f "$gplugin/agents/reflector.md" ] &&
    grep -q '`ghost:reflector`' "$gplugin/skills/reflect/SKILL.md" &&
    ! grep -q '@ghost-claude@' "$gplugin/skills/reflect/SKILL.md" &&
    env -i HOME="$th" "$gprofile/bin/ghost-claude" experience >"$work/waiting" 2>&1 &&
    grep -qx 'no sessions wait to be reflected on' "$work/waiting" &&
    inhome claude plugin validate "$gplugin" >"$work/validate" 2>&1
}
check "the reflector ships in the ghost's plugin, its skill's binary runs, and claude validates it" reflection_ships

# Again, from the same checkout: plain is reused, nothing of it placed again.
pgen=$(gen)
cp "$partlist" "$work/plain-record"
ghost install
rc=$?
check "ghost install again reuses plain: its generation and record unchanged" \
  eval '[ $rc = 0 ] && grep -q "plain    reused" "$work/g" && [ "$(gen)" = "$pgen" ] && cmp -s "$partlist" "$work/plain-record"'

# mAId's plugin turned off by the person: the ghost warns and reuses it,
# never reinstalls or re-enables it, and the genome says so too.
maid_enabled() { inhome claude plugin list --json 2>/dev/null | jq -r '.[] | select(.id == "maid@maid" and .scope == "user") | .enabled'; }
inhome claude plugin disable maid@maid --scope user >/dev/null 2>&1
ghost install
rc=$?
check "with mAId's plugin disabled, ghost install warns, reuses it, and leaves it off" \
  eval '[ $rc = 0 ] && grep -q "mAId.s plugin is disabled; its skills are off" "$work/g" && [ "$(gen)" = "$pgen" ] && cmp -s "$partlist" "$work/plain-record" && [ "$(maid_enabled)" = false ]'
ghost status
check "ghost status says mAId's plugin is disabled" eval 'grep -q "mAId.s plugin is disabled; its skills are off" "$work/g"'
env -i HOME="$th" "$gprofile/bin/ghost-claude" genome >"$work/genome-off" 2>&1
check "the genome's environment says mAId's plugin is disabled" \
  eval 'grep -qx "  mAId.s plugin is disabled; its skills are off" "$work/genome-off"'
inhome claude plugin enable maid@maid --scope user >/dev/null 2>&1

ghost off
check "ghost off: listed disabled" eval '[ "$(glisted)" = "$(gversion) false" ]'
ghost status
check "ghost status says off, at the user's scope" eval 'grep -q "off here (at user)" "$work/g"'
ghost on
check "ghost on: listed enabled, nothing reinstalled" eval '[ "$(glisted)" = "$(gversion) true" ] && [ "$(gen)" = "$pgen" ]'
ghost status
check "ghost status reports its generation, plugin, plain, bring-ins and what waits" \
  eval 'grep -q "generation $(ggen)" "$work/g" && grep -q "on here (at user)" "$work/g" && grep -q "plain    mAId.s plugin $vA" "$work/g" && grep -q "^bring-ins" "$work/g" && grep -q "^sleeping 0 session" "$work/g" && ! grep -q "^warning" "$work/g"'
check "plain status reports no bring-ins" eval 'whole; ! grep -q "^bring-ins" "$work/whole"'

# A second ghost generation, from a clone whose ghost plugin differs and
# whose resources do not: plain is reused, and the ghost rolls back alone.
git clone -q "$here" "$work/e"
echo "ghost marker $RANDOM" >>"$work/e/ghost-in-shell/shell/claude/plugin/agents/reflector.md"
g1=$(gversion)
HOME=$th just -f "$work/e/Justfile" ghost install >"$work/g" 2>&1
rc=$?
g2=$(gversion)
check "a ghost install from a clone with only the ghost changed reuses plain and adds a generation" \
  eval '[ $rc = 0 ] && [ "$g2" != "$g1" ] && [ "$(gen)" = "$pgen" ] && [ "$(glisted)" = "$g2 true" ]'
ghost rollback
rc=$?
check "ghost rollback returns the ghost to its previous install, plain untouched" \
  eval '[ $rc = 0 ] && [ "$(gversion)" = "$g1" ] && [ "$(glisted)" = "$g1 true" ] && [ "$(gen)" = "$pgen" ] && cmp -s "$partlist" "$work/plain-record"'
mkdir -p "$work/gnocore/bin" "$work/gcoreless"
ln -s "$(readlink -f "$gprofile")/share" "$work/gnocore/share"
ln -s "$work/gnocore" "$work/gcoreless/profile-1-link"
ln -s "$(readlink -f "$gprofile")" "$work/gcoreless/profile-2-link"
ln -s profile-2-link "$work/gcoreless/profile"
GHOST_PROFILE=$work/gcoreless/profile inhome just ghost rollback >"$work/out" 2>&1
rc=$?
check "ghost rollback to a generation without its binary is refused" \
  eval '[ $rc != 0 ] && grep -q "has no bin/ghost-claude" "$work/out" && [ "$(readlink "$work/gcoreless/profile")" = profile-2-link ]'

# Plain rolled back under the ghost: the ghost warns and keeps working.
rollback
ghost status
check "with plain rolled back, ghost status warns plain at one revision, ghost at another" \
  eval 'grep -q "^warning  plain at $vD, ghost at $vA" "$work/g"'
ghost install >/dev/null 2>&1

# The ghost's uninstall leaves plain whole.
cp "$partlist" "$work/plain-record"
ghost uninstall
rc=$?
check "ghost uninstall removes its plugin, marketplace, record, profile and the adapter's cache" \
  eval '[ $rc = 0 ] && [ -z "$(glisted)" ] && ! inhome claude plugin marketplace list --json | grep -q ghost-in-shell && [ ! -e "$grecord" ] && [ ! -e "$gprofile" ] && [ ! -e "$th/.local/state/my-harness/shells" ]'
check "ghost uninstall leaves plain whole: its plugin listed and its record byte-identical" \
  eval 'both_at "$vA" && cmp -s "$partlist" "$work/plain-record"'

# Plain uninstalled under the ghost: the ghost says so; then the ghost alone
# installs plain again.
ghost install >/dev/null 2>&1
inhome just uninstall >/dev/null 2>&1
ghost status
check "with plain uninstalled, the ghost's plugin stays and ghost status says mAId's plugin is gone" \
  eval '[ "$(glisted)" = "$(gversion) true" ] && grep -q "mAId.s plugin is not installed" "$work/g"'
ghost install
rc=$?
check "the ghost alone says plain is not installed and installs it" \
  eval '[ $rc = 0 ] && grep -q "mAId.s plugin is not installed; installing the resources from this checkout" "$work/g" && both_at "$vA" && [ "$(glisted)" = "$(gversion) true" ]'
# An install that stopped before its record: uninstall still removes the
# plugin and the marketplace at the ghost's profile, by their place.
rm "$grecord"
ghost uninstall
check "ghost uninstall with no record removes the plugin and marketplace at its profile" \
  eval '[ -z "$(glisted)" ] && ! inhome claude plugin marketplace list --json | grep -q ghost-in-shell'

# ── plain without nix: a profile dir ───────────────────────────────
nonix=$work/nonix-bin
mkdir -p "$nonix"
nonix_path=
while read -r d; do
  [ -n "$d" ] || continue
  if [ -x "$d/nix" ]; then
    for f in "$d"/*; do case "${f##*/}" in nix | nix-*) ;; *) [ -x "$f" ] && ln -sf "$f" "$nonix/" ;; esac; done
  else
    nonix_path=$nonix_path$d:
  fi
done <<<"$(tr ':' '\n' <<<"$PATH")"
nonix_path=$nonix:${nonix_path%:}
th2=$work/home2
mkdir -p "$th2"
dirprofile=$work/dirstate/maid/profile
in2() { HOME=$th2 PATH=$nonix_path MAID_PROFILE=$dirprofile "$@"; }
in2 just plain::install-profile >"$work/n" 2>&1 && in2 just plain::install-skills claude >>"$work/n" 2>&1
rc=$?
dir_version=$(jq -r .version "$dirprofile/share/maid/marketplace/plugins/maid/.claude-plugin/plugin.json" 2>/dev/null)
check "without nix, plain installs into a profile dir: the plugin listed and current, the record written" \
  eval '[ $rc = 0 ] && [ -d "$dirprofile" ] && [ ! -L "$dirprofile" ] && [ "$(HOME=$th2 claude plugin list --json | jq -r ".[] | select(.id == \"maid@maid\") | .version")" = "$dir_version" ] && [ -e "$th2/.local/state/install-records/maid.json" ]'
in2 just rollback >"$work/n" 2>&1
rc=$?
check "without nix, rollback refuses, naming nix" eval '[ $rc != 0 ] && grep -q "rollback needs nix" "$work/n"'
dirghost=$work/dirstate/maid/ghost/profile
GHOST_PROFILE=$dirghost in2 just ghost install >"$work/n" 2>&1
rc=$?
check "without nix, the ghost installs into a profile dir over plain, reusing it, its hooks naming that dir's binary" \
  eval '[ $rc = 0 ] && grep -q "plain    reused" "$work/n" && [ -d "$dirghost" ] && [ ! -L "$dirghost" ] && [ -x "$dirghost/bin/ghost-claude" ] && jq -e --arg core "$dirghost/bin/ghost-claude" "[.hooks[][].hooks[].command | split(\" \")[0]] | all(. == \$core)" "$dirghost/share/ghost/marketplace/plugins/ghost/hooks/hooks.json" >/dev/null && HOME=$th2 claude plugin list --json | jq -e ".[] | select(.id == \"ghost@ghost-in-shell\")" >/dev/null'
GHOST_PROFILE=$dirghost in2 just ghost uninstall >/dev/null 2>&1
in2 just plain::uninstall-skills >/dev/null 2>&1

# With claude and codex off PATH, install and uninstall cannot list the
# bring-ins, so the install record keeps them as mAId's; the uninstall below,
# with the CLIs back, still removes them.
nocli=$(tr ':' '\n' <<<"$PATH" | while read -r d; do
  [ -x "$d/claude" ] || [ -x "$d/codex" ] || printf '%s:' "$d"
done)
# The run saw no CLI (mAId's own plugin is skipped), yet the bring-ins stay placed.
kept_without_cli() {
  for h in claude codex; do
    entries $h | grep -qx "marketplace $vendor" && entries $h | grep -qx "plugin document-skills@$vendor" || return 1
  done
}
PATH=${nocli%:} inhome just plain::install-skills >/dev/null 2>&1
check "install with no claude or codex on PATH keeps the vendor marketplace mAId's" \
  eval 'entries claude | grep -qx "plugin maid@maid skipped" && kept_without_cli'
PATH=${nocli%:} inhome just plain::uninstall-skills >/dev/null 2>&1
check "uninstall with no claude or codex on PATH keeps the vendor marketplace mAId's" kept_without_cli

inhome just plain::uninstall-skills >/dev/null 2>&1
inhome just plain::uninstall-browser-mcp >/dev/null 2>&1
check "uninstall removes the install record" eval '[ ! -e "$partlist" ] && [ ! -e "$oldlist" ]'
check "uninstall takes the plugin-dir grant away" eval '! granted'
check "uninstall takes the config-dir grant away" eval '! writable'
# A listing that is not JSON must not pass as "removed".
vendor_gone() {
  local cli m
  for cli in claude codex; do
    m=$(inhome $cli plugin marketplace list --json 2>/dev/null) && jq -e . <<<"$m" >/dev/null && ! grep -q "$vendor" <<<"$m" || return 1
  done
}
check "uninstall removes the vendor marketplace from claude and codex" vendor_gone
[ "$fails" = 0 ] && echo "all rollback checks passed" || echo "$fails rollback check(s) failed"
exit $((fails > 0))
