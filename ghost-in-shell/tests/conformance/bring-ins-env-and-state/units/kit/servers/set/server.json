{
  "name": "set",
  "_meta": {
    "my-harness": {
      "contract": 1,
      "scope": "session",
      "job": "keep memory",
      "config": {
        "store": {
          "about": "where its memory lives",
          "bind": "arg:--store"
        },
        "token": {
          "about": "a sync token",
          "secret": true,
          "bind": "env:TOKEN"
        }
      },
      "state": {
        "local": "store"
      }
    }
  }
}
