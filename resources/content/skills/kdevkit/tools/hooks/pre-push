#!/bin/sh
# Refuse to publish a branch whose state does not add up, and verify the
# dev loop by RUNNING its checks rather than trusting a report that they
# were run.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PHASE="$here/../phase"
[ -x "$PHASE" ] || exit 0

chain() {
    prev=$(git config --get kdevkit.chain.prePush 2>/dev/null || true)
    [ -n "$prev" ] && [ -x "$prev" ] && "$prev" "$@"
    return 0
}

if ! "$PHASE" applies >/dev/null 2>&1; then
    chain "$@"
    exit 0
fi

# Verification is the checker's job; the hook only decides that it must
# happen before anything is published. Absent configured commands there
# is nothing to verify and nothing to refuse.
if [ -n "$(git config --get kdevkit.qualityCommand 2>/dev/null || true)$(git config --get kdevkit.testCommand 2>/dev/null || true)" ]; then
    if ! "$PHASE" verify; then
        echo "kdevkit: refusing to push — the checks did not pass on what you are publishing." >&2
        exit 1
    fi
fi

chain "$@"
exit 0
