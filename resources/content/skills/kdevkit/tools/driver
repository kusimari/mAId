#!/bin/sh
# kdevkit feature loop — WHAT A CODING AGENT INVOKES.
#
# The driver side. A builder runs these verbs to ask where the work stands,
# to move it on, to go back, or to proceed past a gate on the record. Every
# verb prints the facts it acted on, so an answer can never hide its inputs.
#
# It decides nothing a builder should decide. It refuses what the repository
# contradicts and says what would resolve it; it never refuses a judgement.
#
#   ./install     wires git so the hooks run          (installer side)
#   ./lib/state.sh   what the repository shows         (facts, read-only)
#   ./hooks/*     what git invokes                     (recording side)
set -eu

# shellcheck source=lib/state.sh
# shellcheck disable=SC1007  # CDPATH= is deliberate, not a typo
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$HERE/lib/state.sh"

usage() {
    cat >&2 <<'USAGE'
usage: feature-loop <command> [options]

  ASKING
    show                             where does this feature stand?
    facts                            every fact, one key=value per line
    next                             what follows the current stage?
    check --to <stage>               may we move there? 0 yes, 1 no, 3 undetermined

  MOVING
    advance --next [--ack WHO]       move on; the tooling decides where to
    advance --to <stage> [--ack WHO] move on to a named stage
    return --to <stage> --fault-entered L --issue T --expected-fix T --acceptance T
    except --skipping W --why W [--to S]   proceed past a gate, on the record

  GATES
    verify                           run the project's gates, record the tree

  PLUMBING
    applies                          0 if this branch is a kdevkit feature
    stamp [--subject S]              the trailer block for a new commit
    where                            this tool's directory
USAGE
    exit 2
}

cmd_facts() {
    in_repo
    echo "branch=$(branch)"
    echo "default_branch=$(default_branch)"
    echo "applies=$(yn applies)"
    echo "spec_file=$(spec_file 2>/dev/null || true)"
    echo "stage_recorded=$(stage_recorded)"
    echo "return_count=$(return_count)"
    echo "open_return=$(open_return)"
    echo "has_work_commit=$(yn has_work_commit)"
    echo "has_plan_commit=$(yn has_plan_commit)"
    echo "plan_items_open=$(plan_items_open)"
    echo "plan_items_done=$(plan_items_done)"
    echo "handoff_blocks=$(handoff_blocks)"
    echo "remote_branch=$(yn remote_branch_exists)"
    echo "tree=$(tree_hash)"
    echo "verified_tree=$(verified_tree)"
    echo "checks_verified=$(yn checks_verified)"
}

cmd_show() {
    in_repo
    st=$(stage_recorded)
    echo "stage=${st:-unrecorded}"
    echo "returns=$(return_count)"
    echo "exceptions=$(exception_count)"
    echo "attempts_in_stage=$(attempts_in_stage)"
    # Counts are decision input, not a decision. Nothing here refuses on a
    # threshold; a builder reads it and judges where the fault actually is.
    r=$(return_count)
    a=$(attempts_in_stage)
    [ "$a" -ge 3 ] 2>/dev/null && echo "note=this is attempt $a in ${st:-this stage}; if the same thing keeps failing, the fault may be in an earlier layer"
    [ "$r" -ge 2 ] 2>/dev/null && echo "note=this feature has gone back $r times; consider whether the requirement or design is what is wrong"
    cmd_facts
}

cmd_next() {
    in_repo
    n=$(next_stage "$(stage_recorded)") || {
        echo "no onward stage: the feature is closed" >&2
        return 3
    }
    echo "$n"
}

cmd_check() {
    in_repo
    to=""
    while [ $# -gt 0 ]; do
        case $1 in
            --to) to=${2:-}; shift 2 ;;
            *) usage ;;
        esac
    done
    [ -n "$to" ] || usage
    valid_stage "$to" || die "unknown stage '$to' (expected one of: $STAGES)"
    from=$(stage_recorded)
    if ! legal_forward "$from" "$to"; then
        echo "refused: ${from:-unrecorded} -> $to is not a forward move"
        echo "  to resolve: use 'return' to go back, naming the layer at fault"
        cmd_facts
        return 1
    fi
    msg=$(preconditions "$to") || rc=$?
    rc=${rc:-0}
    [ -n "$msg" ] && echo "$msg"
    [ "$rc" = "0" ] && echo "permitted: ${from:-unrecorded} -> $to"
    cmd_facts
    return "$rc"
}

cmd_advance() {
    in_repo
    to=""; ack=""
    while [ $# -gt 0 ]; do
        case $1 in
            --to) to=${2:-}; shift 2 ;;
            --next) to=$(next_stage "$(stage_recorded)") || die "the feature is closed; there is no onward stage"; shift ;;
            --ack) ack=${2:-}; shift 2 ;;
            *) usage ;;
        esac
    done
    [ -n "$to" ] || usage
    out=$(cmd_check --to "$to") || { echo "$out"; return 1; }
    printf 'phase=%s\nack=%s\n' "$to" "${ack:-unattributed}" > "$(intent_file)"
    echo "recorded: next commit moves to $to"
}

cmd_return() {
    in_repo
    to=""; fault=""; issue=""; fix=""; acc=""
    while [ $# -gt 0 ]; do
        case $1 in
            --to) to=${2:-}; shift 2 ;;
            --fault-entered) fault=${2:-}; shift 2 ;;
            --issue) issue=${2:-}; shift 2 ;;
            --expected-fix) fix=${2:-}; shift 2 ;;
            --acceptance) acc=${2:-}; shift 2 ;;
            *) usage ;;
        esac
    done
    [ -n "$to" ] || usage
    valid_stage "$to" || die "unknown stage '$to' (expected one of: $STAGES)"
    for pair in "fault-entered:$fault" "issue:$issue" "expected-fix:$fix" "acceptance:$acc"; do
        name=${pair%%:*}; val=${pair#*:}
        [ -n "$val" ] || die "return needs --$name; a return without one is not reviewable"
    done
    {
        printf 'phase=%s\nack=%s\nreturn_to=%s\n' "$to" "return" "$to"
        printf 'fault=%s\nissue=%s\nfix=%s\nacceptance=%s\n' "$fault" "$issue" "$fix" "$acc"
    } > "$(intent_file)"
    echo "recorded: next commit returns to $to (fault entered at $fault)"
}

# Proceed past a gate deliberately. Nothing is forbidden; the exception is
# made expensive by being named, counted, and visible at every altitude
# above. A framework that blocks a legitimate judgement cannot be driven.
cmd_except() {
    in_repo
    to=""; skipping=""; why=""
    while [ $# -gt 0 ]; do
        case $1 in
            --to) to=${2:-}; shift 2 ;;
            --skipping) skipping=${2:-}; shift 2 ;;
            --why) why=${2:-}; shift 2 ;;
            *) usage ;;
        esac
    done
    [ -n "$to" ] || to=$(next_stage "$(stage_recorded)") || die "the feature is closed"
    valid_stage "$to" || die "unknown stage '$to' (expected one of: $STAGES)"
    for pair in "skipping:$skipping" "why:$why"; do
        name=${pair%%:*}; val=${pair#*:}
        [ -n "$val" ] || die "an exception needs --$name; an unexplained one is not reviewable"
    done
    # The edge must still be legal: an exception waives a precondition, not
    # the order of the stages.
    from=$(stage_recorded)
    legal_forward "$from" "$to" \
        || die "${from:-unrecorded} -> $to is not a forward move; an exception does not reorder stages"
    printf 'phase=%s\nack=%s\nexception=%s\nexception_why=%s\n' \
        "$to" "exception" "$skipping" "$why" > "$(intent_file)"
    echo "recorded: moving to $to with a stated exception ($skipping)"
    echo "this is counted and visible to anything reading this branch"
}

# Run the project's own quality and test commands and record the tree
# they passed against. This is what makes leaving dev a verified fact
# rather than a report: the commands are observed running here.
cmd_verify() {
    in_repo
    quality=$(gate_command dev quality)
    tests=$(gate_command dev tests)
    if [ -z "$quality$tests" ]; then
        echo "cannot determine: specs/project.md declares no dev gates under '### kdevkit'" >&2
        return 3
    fi
    if ! git diff-index --quiet HEAD -- 2>/dev/null; then
        echo "refused: tracked files are modified, so a result would describe no commit" >&2
        echo "  to resolve: commit or stash them, then verify" >&2
        return 1
    fi
    for pair in "quality checks:$quality" "tests:$tests"; do
        label=${pair%%:*}; cmd=${pair#*:}
        [ -n "$cmd" ] || continue
        if ! sh -c "$cmd" >/dev/null 2>&1; then
            echo "refused: $label failed" >&2
            echo "  command: $cmd" >&2
            return 1
        fi
        echo "verified: $label"
    done
    tree_hash > "$(verified_file)"
    echo "recorded: verified against tree $(tree_hash)"
}

# The trailer block the commit hook appends. Stage comes from the facts,
# not from a claim, so a forgotten advance cannot produce a wrong stamp.
cmd_stamp() {
    in_repo
    pending=""
    while [ $# -gt 0 ]; do
        case $1 in
            --subject) pending=${2:-}; shift 2 ;;
            *) usage ;;
        esac
    done
    f=$(intent_file)
    ack=""; ret=""; exc=""
    if [ -f "$f" ]; then
        # A deliberate move: honour it exactly, including a return, which is
        # the one case where the record legitimately goes backwards.
        stage=$(sed -n 's/^phase=//p' "$f" | head -1)
        ack=$(sed -n 's/^ack=//p' "$f" | head -1)
        ret=$(sed -n 's/^return_to=//p' "$f" | head -1)
        exc=$(sed -n 's/^exception=//p' "$f" | head -1)
    else
        # No move was asked for, so the stage is whichever is further along:
        # what was last recorded, or what this commit's own evidence implies.
        # Without this, an agent that forgets to advance keeps stamping the
        # stage it left behind, and the record quietly lies.
        stage=$(later_stage "$(stage_recorded)" "$(implied_stage "$pending")")
    fi
    [ -n "$stage" ] || stage=planning
    printf '%s: %s\n' "$TRAILER_STAGE" "$stage"
    [ -n "$ack" ] && printf '%s: %s\n' "$TRAILER_ACK" "$ack"
    # A return's four fields ARE the record a later builder reads, so they go
    # onto the branch. Validating them and discarding them, which an earlier
    # version did, removed the reason this exists.
    if [ -n "$ret" ]; then
        printf '%s: %s\n' "$TRAILER_RETURN" "$ret"
        for pair in "Fault:fault" "Issue:issue" "Fix:fix" "Acceptance:acceptance"; do
            label=${pair%%:*}; key=${pair#*:}
            val=$(sed -n "s/^$key=//p" "$f" | head -1)
            [ -n "$val" ] && printf '%s-%s: %s\n' "$TRAILER_RETURN" "$label" "$val"
        done
    fi
    # An exception is a gate passed deliberately, recorded the same way.
    if [ -n "$exc" ]; then
        printf '%s: %s\n' "$TRAILER_EXCEPTION" "$exc"
        val=$(sed -n 's/^exception_why=//p' "$f" | head -1)
        [ -n "$val" ] && printf '%s-Why: %s\n' "$TRAILER_EXCEPTION" "$val"
    fi
    return 0
}

cmd_applies() { in_repo; applies; }

# shellcheck disable=SC2329  # dispatched from the case block below
cmd_where() {
    # shellcheck disable=SC1007  # CDPATH= is deliberate, not a typo
    (CDPATH= cd -- "$(dirname -- "$0")" && pwd)
}

# shellcheck disable=SC2329  # dispatched from the case block below
cmd_where() {
    # shellcheck disable=SC1007  # CDPATH= is deliberate, not a typo
    (CDPATH= cd -- "$(dirname -- "$0")" && pwd)
}

[ $# -gt 0 ] || usage
sub=$1; shift
case $sub in
    show)    cmd_show ;;
    facts)   cmd_facts ;;
    next)    cmd_next ;;
    check)   cmd_check "$@" ;;
    advance) cmd_advance "$@" ;;
    return)  cmd_return "$@" ;;
    except)  cmd_except "$@" ;;
    verify)  cmd_verify ;;
    applies) cmd_applies ;;
    stamp)   cmd_stamp "$@" ;;
    where)   cmd_where ;;
    install|uninstall)
        die "run ./install or ./install --uninstall; wiring git is a separate concern" ;;
    *)       usage ;;
esac
