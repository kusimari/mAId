#!/bin/sh
# Compatibility shim. The tools are now split by role, because a single
# 700-line file could not be reviewed:
#
#   ./install        wires git for one checkout        (writes config)
#   ./driver         what a coding agent invokes       (asks and moves)
#   ./hooks/*        what git invokes                  (records)
#   ./lib/state.sh   what the repository shows         (facts, read-only)
#
# This forwards to the driver so an existing install keeps working.
# shellcheck disable=SC1007  # CDPATH= is deliberate, not a typo
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case ${1:-} in
    install)   shift; exec "$HERE/install" "$@" ;;
    uninstall) shift; exec "$HERE/install" --uninstall "$@" ;;
    *)         exec "$HERE/driver" "$@" ;;
esac
