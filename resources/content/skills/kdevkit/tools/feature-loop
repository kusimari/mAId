#!/bin/sh
# kdevkit feature loop: read git and the feature spec, report facts,
# and permit or refuse a stage change.
#
# The stage is a `Kdevkit-Feature-Stage:` trailer on the branch's most recent
# commit carrying one. Nothing else stores it — see
# specs/feature/kdevkit-deterministic-phasing.md for why. Facts are
# printed alongside every verdict so a verdict can never hide its
# inputs, and an unanswerable question resolves to "no".
set -eu

STAGES="research planning dev review closure closed"
TRAILER_STAGE="Kdevkit-Feature-Stage"
TRAILER_RETURN="Kdevkit-Feature-Return"
TRAILER_ACK="Kdevkit-Feature-Ack"
TRAILER_EXCEPTION="Kdevkit-Feature-Exception"
# Sentinel identifying a hook as ours, so install can recognise a copy of
# itself at any path rather than only at the one it knows about.
MARKER="kdevkit-feature-loop-hook"

die() { echo "phase: $*" >&2; exit 2; }
usage() {
    cat >&2 <<'USAGE'
usage: phase <command> [options]
  facts                              print what is true, one key=value per line
  show                               current stage, facts, return count
  check --to <stage>                 may we move there? 0 yes, 1 no, 3 undetermined
  next                               the onward stage, from the table
  advance --next [--ack WHO]         move on, without naming where
  advance --to <stage> [--ack WHO]   record intent to move
  return --to <stage> --fault-entered L --issue T --expected-fix T --acceptance T
  except --skipping W --why W [--to S]  move on past a gate, on the record
  verify                             run the project's checks, record the tree
  install | uninstall                wire or unwire git hooks for this checkout
  where                              print this tool's directory
  applies                            0 if this branch is a kdevkit feature
  stamp [--subject S]                print the trailer block for a new commit
USAGE
    exit 2
}

in_repo() { git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"; }
git_path() { git rev-parse --git-path "$1"; }
intent_file() { git_path kdevkit-intent; }

branch() { git rev-parse --abbrev-ref HEAD 2>/dev/null || echo ""; }

default_branch() {
    git config --get kdevkit.defaultBranch 2>/dev/null && return 0
    for c in main master; do
        git show-ref --verify --quiet "refs/heads/$c" && { echo "$c"; return 0; }
    done
    echo main
}

# The spec naming this branch. Searched in the working tree, so the very
# first commit of a feature (which creates the spec) still counts.
#
# Specs write the branch line in several shapes, and a literal match on one
# of them made the whole mechanism silently inert on every real spec in this
# project. Match the branch NAME with the surrounding punctuation optional:
# `Branch: x`, `- Branch: \`x\``, `**Branch:** x` all count. Anchored on the
# name so a branch mentioned in prose elsewhere does not qualify a spec.
spec_file() {
    b=$(branch)
    [ -n "$b" ] || return 1
    [ -d specs/feature ] || return 1
    grep -rlE "^[-*[:space:]]*(\*\*)?Branch:?(\*\*)?:?[[:space:]]*.?${b}.?[[:space:]]*$" \
        specs/feature 2>/dev/null | head -1
}

# Is this branch under kdevkit's feature loop? Anything else — the
# default branch, an unrelated branch, initiative-level work — must
# leave every commit untouched.
applies() {
    b=$(branch)
    [ -n "$b" ] || return 1
    [ "$b" != "$(default_branch)" ] || return 1
    [ -n "$(spec_file 2>/dev/null)" ] || [ -n "$(stage_recorded)" ]
}

# Per-project settings live in specs/project.md under `### kdevkit`, the
# same place kdevkit already declares things like the code reviewer —
# not in git config, which is per-clone and invisible to the repo.
#
#   ### kdevkit
#   - `gates:`
#     - `dev:`
#       - `quality: just lint`
#       - `tests: just test`
#
# Read as: the value on the first `key: value` line under the named
# stage's block. Absent configuration means nothing to verify.
gate_command() {
    stage=$1; key=$2
    f=specs/project.md
    [ -f "$f" ] || return 0
    awk -v stage="$stage:" -v key="$key:" '
        /^#/            { in_kdevkit = ($0 ~ /kdevkit/) }
        !in_kdevkit     { next }
        $0 ~ stage      { in_stage = 1; next }
        in_stage && /`[a-z_]+:`[[:space:]]*$/ { in_stage = 0 }
        in_stage {
            line = $0
            gsub(/`/, "", line)
            sub(/^[[:space:]]*-[[:space:]]*/, "", line)
            if (index(line, key) == 1) {
                sub(/^[^:]*:[[:space:]]*/, "", line)
                print line
                exit
            }
        }
    ' "$f"
}

# ── facts ────────────────────────────────────────────────────────
# Each fact is one function so it can be tested alone.

stage_recorded() {
    git log --format="%(trailers:key=$TRAILER_STAGE,valueonly=true,unfold=true)" 2>/dev/null \
        | tr -d '\r' | grep . | head -1 | sed 's/[[:space:]]*$//'
}

return_count() {
    git log --format="%(trailers:key=$TRAILER_RETURN,valueonly=true,unfold=true)" 2>/dev/null \
        | grep -c . || true
}

# A work commit is a conventional type that means implementation, as
# distinct from the plan() commit that opens a feature.
has_work_commit() {
    rng=$(range)
    [ -n "$rng" ] || return 1
    git log --no-decorate --format='%s' "$rng" 2>/dev/null \
        | grep -qE '^(feat|fix|refactor|perf|test)(\(|!|:)'
}

has_plan_commit() {
    rng=$(range)
    [ -n "$rng" ] || return 1
    git log --no-decorate --format='%s' "$rng" 2>/dev/null | grep -qE '^(plan|docs)(\(|!|:)'
}

# The commit carrying the newest `Return-To`, if any. A return resets what
# counts as evidence: work done before going back was work on the old
# understanding, and must not imply the feature is still where it was.
last_return_commit() {
    git log --format="%H%x09%(trailers:key=$TRAILER_RETURN,valueonly=true,unfold=true)" 2>/dev/null \
        | awk -F'\t' 'NF > 1 && $2 != "" { print $1; exit }'
}

# Commits whose evidence counts. Bounded below by the default branch, so a
# long-lived main does not make every feature look like it has work in it,
# and by the newest return, so going back genuinely rewinds the evidence.
range() {
    since=$(last_return_commit)
    if [ -n "$since" ]; then
        echo "$since..HEAD"
        return
    fi
    d=$(default_branch)
    if git show-ref --verify --quiet "refs/heads/$d" && [ "$(branch)" != "$d" ]; then
        echo "$d..HEAD"
    else
        echo "HEAD"
    fi
}

plan_items_open() {
    f=$(spec_file 2>/dev/null) || { echo 0; return; }
    [ -n "$f" ] || { echo 0; return; }
    grep -cE '^[[:space:]]*-[[:space:]]*\[[[:space:]]\]' "$f" 2>/dev/null || true
}

plan_items_done() {
    f=$(spec_file 2>/dev/null) || { echo 0; return; }
    [ -n "$f" ] || { echo 0; return; }
    grep -cE '^[[:space:]]*-[[:space:]]*\[[xX]\]' "$f" 2>/dev/null || true
}

handoff_blocks() {
    f=$(spec_file 2>/dev/null) || { echo 0; return; }
    [ -n "$f" ] || { echo 0; return; }
    grep -c '^## Handoff' "$f" 2>/dev/null || true
}

remote_branch_exists() {
    b=$(branch)
    [ -n "$b" ] || return 1
    [ -n "$(git ls-remote --heads origin "$b" 2>/dev/null)" ]
}

tree_hash() { git rev-parse "HEAD^{tree}" 2>/dev/null || echo ""; }

# Evidence recorded against a tree other than the current one is stale:
# something was edited after it was gathered.
#
# Kept in the worktree's own git directory, NOT in git config: config is
# shared across worktrees, so two features in flight would overwrite each
# other's record. Never committed either — it describes a working tree.
verified_file() { git rev-parse --git-path kdevkit-verified; }

verified_tree() {
    f=$(verified_file)
    [ -f "$f" ] && cat "$f" || true
}

checks_verified() {
    v=$(verified_tree)
    [ -n "$v" ] && [ "$v" = "$(tree_hash)" ]
}

# A return is open while the commit that recorded it is still the newest
# one: nothing has been done about it yet. The fix commit discharges it.
open_return() {
    git log -1 --format="%(trailers:key=$TRAILER_RETURN,valueonly=true,unfold=true)" 2>/dev/null \
        | tr -d '\r' | grep . | head -1 | sed 's/[[:space:]]*$//'
}

yn() { if "$@" >/dev/null 2>&1; then echo yes; else echo no; fi; }

cmd_facts() {
    in_repo
    echo "branch=$(branch)"
    echo "default_branch=$(default_branch)"
    echo "applies=$(yn applies)"
    echo "spec_file=$(spec_file 2>/dev/null || true)"
    echo "stage_recorded=$(stage_recorded)"
    echo "return_count=$(return_count)"
    echo "open_return=$(open_return)"
    echo "has_work_commit=$(yn has_work_commit)"
    echo "has_plan_commit=$(yn has_plan_commit)"
    echo "plan_items_open=$(plan_items_open)"
    echo "plan_items_done=$(plan_items_done)"
    echo "handoff_blocks=$(handoff_blocks)"
    echo "remote_branch=$(yn remote_branch_exists)"
    echo "tree=$(tree_hash)"
    echo "verified_tree=$(verified_tree)"
    echo "checks_verified=$(yn checks_verified)"
}

cmd_show() {
    in_repo
    st=$(stage_recorded)
    echo "stage=${st:-unrecorded}"
    echo "returns=$(return_count)"
    echo "exceptions=$(exception_count)"
    echo "attempts_in_stage=$(attempts_in_stage)"
    # Counts are decision input, not a decision. Nothing here refuses on a
    # threshold; a builder reads it and judges where the fault actually is.
    r=$(return_count)
    a=$(attempts_in_stage)
    [ "$a" -ge 3 ] 2>/dev/null && echo "note=this is attempt $a in ${st:-this stage}; if the same thing keeps failing, the fault may be in an earlier layer"
    [ "$r" -ge 2 ] 2>/dev/null && echo "note=this feature has gone back $r times; consider whether the requirement or design is what is wrong"
    cmd_facts
}

# How many commits have been made in the current stage. Repeated failure at
# one stage is evidence about a different one.
attempts_in_stage() {
    st=$(stage_recorded)
    [ -n "$st" ] || { echo 0; return; }
    git log --format="%(trailers:key=$TRAILER_STAGE,valueonly=true,unfold=true)" 2>/dev/null \
        | awk -v s="$st" 'BEGIN{n=0} {gsub(/[[:space:]]/,"")} $0==s{n++; next} $0!=""{exit} END{print n}'
}

# ── the closed table of moves ────────────────────────────────────
# Forward edges only. Going back is handled by `return`, which is
# always permitted and always recorded.
legal_forward() {
    from=$1; to=$2
    case "${from:-unrecorded}:$to" in
        unrecorded:research|unrecorded:planning) return 0 ;;
        research:planning) return 0 ;;
        planning:dev) return 0 ;;
        dev:review) return 0 ;;
        review:closure) return 0 ;;
        closure:closed) return 0 ;;
        *) return 1 ;;
    esac
}

# The onward stage, from the table rather than from any phase module's
# prose. A module states what it must achieve and asks where that leads,
# so adding a stage never means editing the module before it.
next_stage() {
    from=${1:-}
    case "${from:-unrecorded}" in
        unrecorded) echo planning ;;
        research)   echo planning ;;
        planning)   echo dev ;;
        dev)        echo review ;;
        review)     echo closure ;;
        closure)    echo closed ;;
        *)          return 3 ;;
    esac
}

cmd_next() {
    in_repo
    n=$(next_stage "$(stage_recorded)") || {
        echo "no onward stage: the feature is closed" >&2
        return 3
    }
    echo "$n"
}

valid_stage() {
    for s in $STAGES; do [ "$1" = "$s" ] && return 0; done
    return 1
}

# Conditions beyond edge legality. Returns 0 permit, 1 refuse, 3 cannot
# determine. Prints the reason on refusal.
preconditions() {
    to=$1
    if [ -z "$(spec_file 2>/dev/null)" ]; then
        echo "cannot determine: no spec in specs/feature names branch $(branch)"
        return 3
    fi
    hb=$(handoff_blocks)
    if [ "$hb" != "1" ]; then
        echo "refused: the spec must have exactly one '## Handoff' section, found $hb"
        echo "  to resolve: leave one block and delete the others"
        return 1
    fi
    r=$(open_return)
    if [ -n "$r" ]; then
        echo "refused: a return to '$r' is the newest thing on this branch"
        echo "  to resolve: do the work it asks for and commit it; that discharges the return"
        return 1
    fi
    case "$to" in
        dev)
            if ! has_plan_commit; then
                echo "refused: the spec is not committed yet"
                echo "  to resolve: commit the spec as plan(<feature>): ..."
                return 1
            fi
            ;;
        review)
            if ! has_work_commit; then
                echo "refused: no implementation commit on this branch"
                echo "  to resolve: commit the work, or record an exception if there is genuinely none"
                return 1
            fi
            open=$(plan_items_open)
            if [ "$open" != "0" ]; then
                echo "refused: $open implementation plan item(s) still unticked"
                echo "  to resolve: tick them, or run 'except --skipping \"plan items\" --why ...'"
                return 1
            fi
            if ! checks_verified; then
                echo "refused: the gates have not been observed passing on this tree"
                echo "  to resolve: run 'feature-loop verify', or record an exception"
                return 1
            fi
            ;;
        closure)
            if ! remote_branch_exists; then
                echo "refused: branch $(branch) is not on the remote, so it cannot have been reviewed"
                echo "  to resolve: push it, or record an exception if review happened elsewhere"
                return 1
            fi
            ;;
    esac
    return 0
}

cmd_check() {
    in_repo
    to=""
    while [ $# -gt 0 ]; do
        case $1 in
            --to) to=${2:-}; shift 2 ;;
            *) usage ;;
        esac
    done
    [ -n "$to" ] || usage
    valid_stage "$to" || die "unknown stage '$to' (expected one of: $STAGES)"
    from=$(stage_recorded)
    if ! legal_forward "$from" "$to"; then
        echo "refused: ${from:-unrecorded} -> $to is not a forward move"
        echo "  to resolve: use 'return' to go back, naming the layer at fault"
        cmd_facts
        return 1
    fi
    msg=$(preconditions "$to") || rc=$?
    rc=${rc:-0}
    [ -n "$msg" ] && echo "$msg"
    [ "$rc" = "0" ] && echo "permitted: ${from:-unrecorded} -> $to"
    cmd_facts
    return "$rc"
}

cmd_advance() {
    in_repo
    to=""; ack=""
    while [ $# -gt 0 ]; do
        case $1 in
            --to) to=${2:-}; shift 2 ;;
            --next) to=$(next_stage "$(stage_recorded)") || die "the feature is closed; there is no onward stage"; shift ;;
            --ack) ack=${2:-}; shift 2 ;;
            *) usage ;;
        esac
    done
    [ -n "$to" ] || usage
    out=$(cmd_check --to "$to") || { echo "$out"; return 1; }
    printf 'phase=%s\nack=%s\n' "$to" "${ack:-unattributed}" > "$(intent_file)"
    echo "recorded: next commit moves to $to"
}

cmd_return() {
    in_repo
    to=""; fault=""; issue=""; fix=""; acc=""
    while [ $# -gt 0 ]; do
        case $1 in
            --to) to=${2:-}; shift 2 ;;
            --fault-entered) fault=${2:-}; shift 2 ;;
            --issue) issue=${2:-}; shift 2 ;;
            --expected-fix) fix=${2:-}; shift 2 ;;
            --acceptance) acc=${2:-}; shift 2 ;;
            *) usage ;;
        esac
    done
    [ -n "$to" ] || usage
    valid_stage "$to" || die "unknown stage '$to' (expected one of: $STAGES)"
    for pair in "fault-entered:$fault" "issue:$issue" "expected-fix:$fix" "acceptance:$acc"; do
        name=${pair%%:*}; val=${pair#*:}
        [ -n "$val" ] || die "return needs --$name; a return without one is not reviewable"
    done
    {
        printf 'phase=%s\nack=%s\nreturn_to=%s\n' "$to" "return" "$to"
        printf 'fault=%s\nissue=%s\nfix=%s\nacceptance=%s\n' "$fault" "$issue" "$fix" "$acc"
    } > "$(intent_file)"
    echo "recorded: next commit returns to $to (fault entered at $fault)"
}

# The stage the repository itself implies, regardless of what was last
# recorded or asked for. This is what stops a forgotten `advance` from
# leaving the record behind reality: an agent that commits implementation
# work is in dev whether or not it said so.
#
# Only stages with an observable signature are derived. Review and closure
# are human acts with no fact that distinguishes them, so they are never
# inferred — they must be recorded deliberately.
# `$1` is the subject of the commit being prepared, which is not in
# history yet — the stamp runs before the commit exists, so without this
# a commit's own evidence could not count toward its own stage.
implied_stage() {
    pending=${1:-}
    if printf '%s' "$pending" | grep -qE '^(feat|fix|refactor|perf|test)(\(|!|:)' || has_work_commit; then
        echo dev
    elif printf '%s' "$pending" | grep -qE '^(plan|docs)(\(|!|:)' || has_plan_commit; then
        echo planning
    else
        echo ""
    fi
}

# Stage ordering, for taking the later of two. A record may move forward
# on its own evidence; it must never slide backwards without a `return`.
stage_rank() {
    case "${1:-}" in
        research) echo 1 ;;
        planning) echo 2 ;;
        dev)      echo 3 ;;
        review)   echo 4 ;;
        closure)  echo 5 ;;
        closed)   echo 6 ;;
        *)        echo 0 ;;
    esac
}

later_stage() {
    a=$1; b=$2
    [ "$(stage_rank "$a")" -ge "$(stage_rank "$b")" ] && { echo "$a"; return; }
    echo "$b"
}

# The trailer block the commit hook appends. Stage comes from the facts,
# not from a claim, so a forgotten advance cannot produce a wrong stamp.
cmd_stamp() {
    in_repo
    pending=""
    while [ $# -gt 0 ]; do
        case $1 in
            --subject) pending=${2:-}; shift 2 ;;
            *) usage ;;
        esac
    done
    f=$(intent_file)
    ack=""; ret=""; exc=""
    if [ -f "$f" ]; then
        # A deliberate move: honour it exactly, including a return, which is
        # the one case where the record legitimately goes backwards.
        stage=$(sed -n 's/^phase=//p' "$f" | head -1)
        ack=$(sed -n 's/^ack=//p' "$f" | head -1)
        ret=$(sed -n 's/^return_to=//p' "$f" | head -1)
        exc=$(sed -n 's/^exception=//p' "$f" | head -1)
    else
        # No move was asked for, so the stage is whichever is further along:
        # what was last recorded, or what this commit's own evidence implies.
        # Without this, an agent that forgets to advance keeps stamping the
        # stage it left behind, and the record quietly lies.
        stage=$(later_stage "$(stage_recorded)" "$(implied_stage "$pending")")
    fi
    [ -n "$stage" ] || stage=planning
    printf '%s: %s\n' "$TRAILER_STAGE" "$stage"
    [ -n "$ack" ] && printf '%s: %s\n' "$TRAILER_ACK" "$ack"
    # A return's four fields ARE the record a later builder reads, so they go
    # onto the branch. Validating them and discarding them, which an earlier
    # version did, removed the reason this exists.
    if [ -n "$ret" ]; then
        printf '%s: %s\n' "$TRAILER_RETURN" "$ret"
        for pair in "Fault:fault" "Issue:issue" "Fix:fix" "Acceptance:acceptance"; do
            label=${pair%%:*}; key=${pair#*:}
            val=$(sed -n "s/^$key=//p" "$f" | head -1)
            [ -n "$val" ] && printf '%s-%s: %s\n' "$TRAILER_RETURN" "$label" "$val"
        done
    fi
    # An exception is a gate passed deliberately, recorded the same way.
    if [ -n "$exc" ]; then
        printf '%s: %s\n' "$TRAILER_EXCEPTION" "$exc"
        val=$(sed -n 's/^exception_why=//p' "$f" | head -1)
        [ -n "$val" ] && printf '%s-Why: %s\n' "$TRAILER_EXCEPTION" "$val"
    fi
    return 0
}

# Proceed past a gate deliberately. Nothing is forbidden; the exception is
# made expensive by being named, counted, and visible at every altitude
# above. A framework that blocks a legitimate judgement cannot be driven.
cmd_except() {
    in_repo
    to=""; skipping=""; why=""
    while [ $# -gt 0 ]; do
        case $1 in
            --to) to=${2:-}; shift 2 ;;
            --skipping) skipping=${2:-}; shift 2 ;;
            --why) why=${2:-}; shift 2 ;;
            *) usage ;;
        esac
    done
    [ -n "$to" ] || to=$(next_stage "$(stage_recorded)") || die "the feature is closed"
    valid_stage "$to" || die "unknown stage '$to' (expected one of: $STAGES)"
    for pair in "skipping:$skipping" "why:$why"; do
        name=${pair%%:*}; val=${pair#*:}
        [ -n "$val" ] || die "an exception needs --$name; an unexplained one is not reviewable"
    done
    # The edge must still be legal: an exception waives a precondition, not
    # the order of the stages.
    from=$(stage_recorded)
    legal_forward "$from" "$to" \
        || die "${from:-unrecorded} -> $to is not a forward move; an exception does not reorder stages"
    printf 'phase=%s\nack=%s\nexception=%s\nexception_why=%s\n' \
        "$to" "exception" "$skipping" "$why" > "$(intent_file)"
    echo "recorded: moving to $to with a stated exception ($skipping)"
    echo "this is counted and visible to anything reading this branch"
}

exception_count() {
    git log --format="%(trailers:key=$TRAILER_EXCEPTION,valueonly=true,unfold=true)" 2>/dev/null \
        | grep -c . || true
}

# Run the project's own quality and test commands and record the tree
# they passed against. This is what makes leaving dev a verified fact
# rather than a report: the commands are observed running here.
cmd_verify() {
    in_repo
    quality=$(gate_command dev quality)
    tests=$(gate_command dev tests)
    if [ -z "$quality$tests" ]; then
        echo "cannot determine: specs/project.md declares no dev gates under '### kdevkit'" >&2
        return 3
    fi
    if ! git diff-index --quiet HEAD -- 2>/dev/null; then
        echo "refused: tracked files are modified, so a result would describe no commit" >&2
        echo "  to resolve: commit or stash them, then verify" >&2
        return 1
    fi
    for pair in "quality checks:$quality" "tests:$tests"; do
        label=${pair%%:*}; cmd=${pair#*:}
        [ -n "$cmd" ] || continue
        if ! sh -c "$cmd" >/dev/null 2>&1; then
            echo "refused: $label failed" >&2
            echo "  command: $cmd" >&2
            return 1
        fi
        echo "verified: $label"
    done
    tree_hash > "$(verified_file)"
    echo "recorded: verified against tree $(tree_hash)"
}

# Wire git to kdevkit's hooks for this checkout, preserving whatever was
# already there. Scoped to the worktree when the repo has that enabled,
# so a feature worktree can be wired without touching the main checkout;
# otherwise local, where the hook's own scope check keeps other branches
# untouched.
cmd_install() {
    in_repo
    # shellcheck disable=SC1007  # CDPATH= is deliberate, not a typo
    # shellcheck disable=SC1007  # CDPATH= is deliberate, not a typo
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    hooks="$here/hooks"
    [ -d "$hooks" ] || die "no hooks directory at $hooks"

    prev=$(git config --get core.hooksPath 2>/dev/null || true)
    # Never chain a kdevkit hook to itself. Comparing paths is not enough:
    # another checkout's copy of the same hook has a different path, and
    # chaining it makes prepare-commit-msg call itself until the shell dies
    # at depth 1000 — which bricks committing entirely. Found by an agent
    # run, not by any test. Identify ours by content, not location.
    if [ -n "$prev" ] && [ "$prev" != "$hooks" ] \
       && ! grep -qs "$MARKER" "$prev/prepare-commit-msg" "$prev/pre-push"; then
        # Remember the displaced hooks so ours can call them.
        for h in prepare-commit-msg pre-push; do
            [ -x "$prev/$h" ] || continue
            key=$(printf '%s' "$h" | awk -F- '{printf "%s", $1; for(i=2;i<=NF;i++) printf "%s%s", toupper(substr($i,1,1)), substr($i,2)}')
            git config "kdevkit.chain.$key" "$prev/$h"
            echo "chained existing $h -> $prev/$h"
        done
    fi

    scope=--local
    if [ "$(git config --get extensions.worktreeConfig 2>/dev/null || true)" = "true" ]; then
        scope=--worktree
    fi
    git config $scope core.hooksPath "$hooks"
    # Record where the tools are so the instructions can name them
    # portably: `$(git config kdevkit.tools)/feature-loop`. Read-only after
    # install and identical for every worktree, so nothing contends.
    git config kdevkit.tools "$here"
    echo "hooks path set ($scope): $hooks"
    echo "tools recorded: git config kdevkit.tools -> $here"
    echo "note: declare this project's gates under '### kdevkit' in specs/project.md"
}

cmd_uninstall() {
    in_repo
    scope=--local
    if [ "$(git config --get extensions.worktreeConfig 2>/dev/null || true)" = "true" ]; then
        scope=--worktree
    fi
    git config $scope --unset core.hooksPath 2>/dev/null || true
    for key in prepareCommitMsg prePush; do
        git config --unset "kdevkit.chain.$key" 2>/dev/null || true
    done
    git config --unset kdevkit.tools 2>/dev/null || true
    rm -f "$(verified_file)" 2>/dev/null || true
    echo "hooks path unset; kdevkit state cleared"
}

cmd_applies() { in_repo; applies; }

cmd_where() {
    # shellcheck disable=SC1007  # CDPATH= is deliberate, not a typo
    (CDPATH= cd -- "$(dirname -- "$0")" && pwd)
}

[ $# -gt 0 ] || usage
sub=$1; shift
case $sub in
    facts)   cmd_facts ;;
    show)    cmd_show ;;
    check)   cmd_check "$@" ;;
    advance) cmd_advance "$@" ;;
    return)  cmd_return "$@" ;;
    stamp)   cmd_stamp "$@" ;;
    next)    cmd_next ;;
    verify)  cmd_verify ;;
    except)  cmd_except "$@" ;;
    install) cmd_install ;;
    uninstall) cmd_uninstall ;;
    applies) cmd_applies ;;
    where)   cmd_where ;;
    *)       usage ;;
esac
