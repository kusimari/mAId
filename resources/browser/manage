#!/usr/bin/env bash
# mAId/resources/browser/manage — register / unregister / report
# the browser-control MCP server with each installed coding agent
# (claude, kiro, codex). Invoked by the *-browser-mcp verbs in
# resources/Justfile; not meant to be called directly.
#
# The server is registered to launch via resources/browser/launch
# (passed as $LAUNCHER), which enforces the user's allowlist. We
# register a runnable command, not a symlink, so this lives in
# shell over each harness's own MCP CLI rather than in the
# pure-symlink build-tool.
#
# Design notes:
#   - Data-driven, mirroring the Rust REGISTRY's shape: one row per
#     agent in MCP_AGENTS drives a generic loop (mcp_foreach); the
#     three leaf dispatchers carry only the per-CLI differences.
#     Adding an agent is a row, not a new function.
#   - Idempotent. Claude's `mcp add` errors if the name exists, so
#     it removes-then-adds (the `readd` style); kiro's and codex's
#     `mcp add` already replace.
#   - Graceful per-prereq skip: no GUI Chrome, no `nix` (the MCP
#     runtime comes from mAId's flake, entered by the launcher), or
#     a missing harness CLI prints a one-line pointer and is
#     skipped, never a hard error — a machine may have one harness
#     and not the other, or no browser at all.
#   - Allowlist is user data: uninstall never touches it.
#   - Agent scope: claude and codex are GLOBAL (a server is visible
#     to every session). Kiro partitions MCP servers PER SUB-AGENT
#     and `kiro-cli chat` runs a specific one — so kiro must be
#     named explicitly; absent a sub-agent name, kiro is skipped
#     (mAId never guesses which of the user's agents to write into).
#   - Agent filter: the optional <agent> arg scopes to one coding
#     agent; empty means all three.
#
# Usage:
#   manage install   <launcher> [agent] [kiro-sub-agent]
#   manage uninstall  [agent] [kiro-sub-agent]
#   manage status     [agent] [kiro-sub-agent]
#   manage allow      <pattern>

set -euo pipefail

SERVER_NAME="chrome-devtools"
ALLOWLIST="${MAID_BROWSER_ALLOWLIST:-${XDG_CONFIG_HOME:-$HOME/.config}/maid/browser-allowlist}"

info() { printf '  %s\n' "$*"; }
skip() { printf 'skip  %s\n' "$*"; }
ok()   { printf 'ok    %s\n' "$*"; }

# ── prereqs ──────────────────────────────────────────────────────

have() { command -v "$1" >/dev/null 2>&1; }

# A graphical Chrome we could attach to. macOS: the app bundle.
# Linux: a chrome/chromium binary on PATH. Headless boxes have
# neither, by design.
chrome_present() {
    [[ -d "/Applications/Google Chrome.app" ]] && return 0
    have google-chrome || have google-chrome-stable || have chromium || have chromium-browser
}

# ── per-agent registrar table ────────────────────────────────────
# One row per coding agent, mirroring the Rust REGISTRY's data-driven
# shape: the loop and every shared decision (PATH check, per-agent
# skip, message framing) live once in mcp_foreach; the three leaf
# dispatchers below carry only the irreducible per-CLI differences.
#
#   agent  cli        scope       style
#   scope  global     one server, visible to every session (claude, codex)
#          per-agent  registered under a named sub-agent (kiro)
#   style  readd      `mcp add` errors if the name exists → remove first (claude)
#          replace    `mcp add` is add-or-replace, idempotent (kiro, codex)
MCP_AGENTS=(
    "claude  claude    global      readd"
    "kiro    kiro-cli  per-agent   replace"
    "codex   codex     global      replace"
)

KNOWN_AGENTS="claude kiro codex"

# Reject an agent filter that isn't a coding agent we know — a clear
# error beats silently acting on nothing. Empty = all agents.
validate_agent_filter() {
    local f="$1" a
    [[ -z "$f" ]] && return 0
    for a in $KNOWN_AGENTS; do [[ "$f" == "$a" ]] && return 0; done
    printf 'manage: unknown coding agent %q (known: %s)\n' "$f" "$KNOWN_AGENTS" >&2
    exit 2
}

# Walk the table applying <op> to each agent that matches AGENT_FILTER
# (empty = all) and is present. Uses SERVER_NAME / LAUNCHER /
# AGENT_FILTER / KIRO_AGENT from the caller.
mcp_foreach() {
    local op="$1" row agent cli scope style
    for row in "${MCP_AGENTS[@]}"; do
        read -r agent cli scope style <<<"$row"
        [[ -n "$AGENT_FILTER" && "$AGENT_FILTER" != "$agent" ]] && continue
        have "$cli" || { skip "$agent ($cli not on PATH)"; continue; }
        # A per-agent CLI (kiro) can't be targeted without a named
        # sub-agent — mAId never guesses which one to write into.
        if [[ "$scope" == per-agent && -z "${KIRO_AGENT:-}" ]]; then
            skip "$agent (no sub-agent named — pass '<agent> <sub-agent>' to target it)"
            continue
        fi
        case "$op" in
            install)   op_install "$agent" "$style" ;;
            uninstall) op_uninstall "$agent" ;;
            status)    op_status "$agent" ;;
        esac
    done
}

# A "; agent <name>" tail only for the per-agent CLI, so global
# agents' messages don't sprout a meaningless sub-agent note.
agent_note() { [[ "$1" == kiro ]] && printf ' (agent %s)' "$KIRO_AGENT"; }

# Left-pad the agent name so multi-agent output stays column-aligned.
label() { printf '%-6s' "$1"; }

op_install() {
    local agent="$1" style="$2" out
    # readd agents error on a duplicate name; clear it first so a
    # re-run refreshes rather than fails.
    if [[ "$style" == readd ]]; then
        mcp_remove "$agent" >/dev/null 2>&1 || true
    fi
    if out="$(mcp_add "$agent" 2>&1)"; then
        ok "$(label "$agent") ($SERVER_NAME → $LAUNCHER)$(agent_note "$agent")"
    else
        # Surface the CLI's own first line (e.g. "Agent X does not
        # exist", "not logged in") so the skip is actionable.
        skip "$(label "$agent") (mcp add failed: $(printf '%s' "$out" | head -n1))"
    fi
}

op_uninstall() {
    local agent="$1"
    # codex's `mcp remove` exits 0 whether or not the server existed,
    # so gate its "removed" claim on a prior registration check to
    # avoid a misleading message on a clean machine. claude/kiro
    # return nonzero when absent, so their branch is already honest.
    if [[ "$agent" == codex ]] && ! mcp_get "$agent"; then
        mcp_remove "$agent" >/dev/null 2>&1 || true
        info "$(label "$agent") ($SERVER_NAME not registered)"
        return
    fi
    if mcp_remove "$agent" >/dev/null 2>&1; then
        ok "$(label "$agent") (removed $SERVER_NAME)$(agent_note "$agent")"
    else
        info "$(label "$agent") ($SERVER_NAME not registered)$(agent_note "$agent")"
    fi
}

op_status() {
    local agent="$1"
    if mcp_get "$agent"; then
        ok "$(label "$agent") ($SERVER_NAME registered)$(agent_note "$agent")"
    else
        info "$(label "$agent") ($SERVER_NAME not registered)$(agent_note "$agent")"
    fi
}

# ── leaf dispatchers: the only per-CLI-different code ─────────────

mcp_add() {
    case "$1" in
        claude) claude   mcp add -s user "$SERVER_NAME" -- "$LAUNCHER" ;;
        kiro)   kiro-cli mcp add --name "$SERVER_NAME" --agent "$KIRO_AGENT" --command "$LAUNCHER" ;;
        codex)  codex    mcp add "$SERVER_NAME" -- "$LAUNCHER" ;;
    esac
}

mcp_remove() {
    case "$1" in
        claude) claude   mcp remove -s user "$SERVER_NAME" ;;
        kiro)   kiro-cli mcp remove --name "$SERVER_NAME" --agent "$KIRO_AGENT" ;;
        codex)  codex    mcp remove "$SERVER_NAME" ;;
    esac
}

# 0 = registered. claude/codex have a direct `mcp get`; kiro has no
# per-agent status flag, so parse the agent's block in `mcp list`
# (which kiro writes to stderr, hence 2>&1, with ANSI colour stripped).
mcp_get() {
    case "$1" in
        claude) claude mcp get "$SERVER_NAME" >/dev/null 2>&1 ;;
        codex)  codex  mcp get "$SERVER_NAME" >/dev/null 2>&1 ;;
        kiro)
            kiro-cli mcp list 2>&1 \
                | sed 's/\x1b\[[0-9;]*m//g' \
                | awk -v a="$KIRO_AGENT" -v s="$SERVER_NAME" '
                    # Exact string compares (not regex) so agent/server
                    # names with metacharacters cannot mis-match. The
                    # block is the agent header line until the next
                    # "  <header>".
                    $0 == "  " a {inblk=1; next}
                    /^  [^ ]/ {inblk=0}
                    inblk && $2 == s {found=1}
                    END {exit !found}'
            ;;
    esac
}

# ── subcommands ──────────────────────────────────────────────────

cmd_install() {
    LAUNCHER="${1:?manage install: launcher path required}"
    AGENT_FILTER="${2:-}"
    KIRO_AGENT="${3:-}"
    validate_agent_filter "$AGENT_FILTER"
    # A non-executable launcher is a packaging bug, not an
    # environment gap — hard-fail to stderr, unlike the graceful
    # prereq skips below.
    [[ -x "$LAUNCHER" ]] || { printf 'manage: launcher not executable: %s\n' "$LAUNCHER" >&2; exit 1; }

    if ! chrome_present; then
        skip "install-browser-mcp (no graphical Chrome found — desktop only)"
        return 0
    fi
    # The MCP runtime (Node.js) comes from mAId's own flake — the
    # launcher enters it via `nix develop`, so node need not be on
    # the user's PATH. `nix` itself is the prerequisite (the repo's
    # standing requirement). Check it for a clear up-front skip.
    if ! have nix; then
        skip "install-browser-mcp (nix not on PATH — mAId provides the MCP runtime via its flake; nix is the repo prerequisite)"
        return 0
    fi

    mcp_foreach install

    # Warm the flake now so the FIRST real browser-MCP connection
    # isn't stalled (and the MCP handshake doesn't time out) while
    # nix builds the devShell on a cold cache. Derived from the
    # launcher path: <repo>/resources/browser/launch → <repo>.
    local repo_root
    repo_root="$(cd -P "$(dirname "$LAUNCHER")/../.." && pwd)"
    printf '\nWarming the mAId flake (first build may take a while)...\n'
    if nix develop "path:$repo_root" --command true >/dev/null 2>&1; then
        ok "flake ready (npx available to the launcher)"
    else
        info "flake warm-up failed — first connection will build it on demand"
    fi

    printf '\nOne-time browser setup (do this once, by hand):\n'
    info "open chrome://inspect/#remote-debugging in Chrome, enable remote"
    info "debugging, and accept the permission prompt the first time the"
    info "agent attaches."
    printf '\nAllowlist (deny-by-default — add at least one site before use):\n'
    info "$ALLOWLIST"
    info "edit directly, or: just resources::browser-mcp-allow '<pattern>'"
}

cmd_uninstall() {
    AGENT_FILTER="${1:-}"
    KIRO_AGENT="${2:-}"
    validate_agent_filter "$AGENT_FILTER"
    mcp_foreach uninstall
    info "allowlist left in place (user data): $ALLOWLIST"
}

cmd_status() {
    AGENT_FILTER="${1:-}"
    KIRO_AGENT="${2:-}"
    validate_agent_filter "$AGENT_FILTER"
    mcp_foreach status
    if [[ -s "$ALLOWLIST" ]]; then
        local n
        n="$(grep -cvE '^\s*(#|$)' "$ALLOWLIST" || true)"
        info "allowlist: $n pattern(s) in $ALLOWLIST"
    else
        info "allowlist: empty/absent ($ALLOWLIST) — capability denies all until a site is added"
    fi
}

cmd_allow() {
    local pattern="${1:?manage allow: pattern required}"
    mkdir -p "$(dirname "$ALLOWLIST")"
    printf '%s\n' "$pattern" >>"$ALLOWLIST"
    ok "added to $ALLOWLIST: $pattern"
    info "takes effect on the next browser-control session (Chrome is not restarted)"
}

# ── dispatch ─────────────────────────────────────────────────────

sub="${1:-}"; shift || true
case "$sub" in
    install)   cmd_install "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    status)    cmd_status "$@" ;;
    allow)     cmd_allow "$@" ;;
    *) printf 'manage: unknown subcommand %q (want: install|uninstall|status|allow)\n' "$sub" >&2; exit 2 ;;
esac
