#!/usr/bin/env bash
# mAId/resources/browser/manage — register / unregister / report
# the browser-control MCP server with each installed coding agent
# (claude, kiro, codex). Invoked by the *-browser-mcp verbs in
# resources/Justfile; not meant to be called directly.
#
# The server is registered to launch via the profile's
# maid-browser-mcp (passed as $LAUNCHER), the flake's wrap of
# resources/browser/launch, which enforces the user's allowlist. We
# register a runnable command, not a symlink, so this lives in
# shell over each harness's own MCP CLI rather than in the
# pure-symlink build-tool.
#
# Design notes:
#   - Data-driven, mirroring the Rust REGISTRY's shape: one row per
#     agent in MCP_AGENTS drives a generic loop (mcp_foreach); the
#     three leaf dispatchers carry only the per-CLI differences.
#     Adding an agent is a row, not a new function.
#   - Idempotent. Claude's `mcp add` errors if the name exists, so
#     it removes-then-adds (the `readd` style); codex's `mcp add`
#     already replaces, and kiro's entry is set in place.
#   - Graceful per-prereq skip: no GUI Chrome or a missing harness
#     CLI prints a one-line pointer and is skipped, never a hard
#     error (the runtime is in the launcher's closure, so nothing
#     else is needed) — a machine may have one harness
#     and not the other, or no browser at all.
#   - Allowlist is user data: uninstall never touches it.
#   - Every agent is registered globally. Kiro's server goes into its
#     global config (~/.kiro/settings/mcp.json), which kiro agents pull
#     in, edited here with jq: `kiro-cli mcp add` needs a login and
#     writes every other server back through its own struct, dropping
#     keys it does not know. The entry is mAId's only while its command
#     is the launcher; another same-named entry is left alone.
#   - Agent filter: the optional <agent> arg scopes to one coding
#     agent; empty means all three.
#
# Usage:
#   manage install   <launcher> [agent]
#   manage uninstall <launcher> [agent]
#   manage status    <launcher> [agent]
#   manage allow      <pattern>

set -euo pipefail

SERVER_NAME="chrome-devtools"
ALLOWLIST="${MAID_BROWSER_ALLOWLIST:-${XDG_CONFIG_HOME:-$HOME/.config}/maid/browser-allowlist}"
KIRO_MCP="$HOME/.kiro/settings/mcp.json"

info() { printf '  %s\n' "$*"; }
skip() { printf 'skip  %s\n' "$*"; }
ok()   { printf 'ok    %s\n' "$*"; }

# ── prereqs ──────────────────────────────────────────────────────

have() { command -v "$1" >/dev/null 2>&1; }

# A graphical Chrome we could attach to. macOS: the app bundle.
# Linux: a chrome/chromium binary on PATH. Headless boxes have
# neither, by design.
chrome_present() {
    [[ -d "/Applications/Google Chrome.app" ]] && return 0
    have google-chrome || have google-chrome-stable || have chromium || have chromium-browser
}

# ── per-agent registrar table ────────────────────────────────────
# One row per coding agent, mirroring the Rust REGISTRY's data-driven
# shape: the loop and every shared decision (PATH check, per-agent
# skip, message framing) live once in mcp_foreach; the three leaf
# dispatchers below carry only the irreducible per-CLI differences.
#
#   agent  cli       style
#   style  readd     `mcp add` errors if the name exists → remove first (claude)
#          replace   adding is add-or-replace, idempotent (kiro, codex)
MCP_AGENTS=(
    "claude  claude    readd"
    "kiro    kiro-cli  replace"
    "codex   codex     replace"
)

KNOWN_AGENTS="claude kiro codex"

# Reject an agent filter that isn't a coding agent we know — a clear
# error beats silently acting on nothing. Empty = all agents.
validate_agent_filter() {
    local f="$1" a
    [[ -z "$f" ]] && return 0
    # agy gets skills but has no MCP registration here; `just install agy`
    # passes it through, so it is a skip, not a usage error.
    [[ "$f" == agy ]] && { skip "agy (no browser MCP registration for agy)"; exit 0; }
    for a in $KNOWN_AGENTS; do [[ "$f" == "$a" ]] && return 0; done
    printf 'manage: unknown coding agent %q (known: %s)\n' "$f" "$KNOWN_AGENTS" >&2
    exit 2
}

# Walk the table applying <op> to each agent that matches AGENT_FILTER
# (empty = all) and is present. Uses SERVER_NAME / LAUNCHER /
# AGENT_FILTER from the caller.
mcp_foreach() {
    local op="$1" row agent cli style
    for row in "${MCP_AGENTS[@]}"; do
        read -r agent cli style <<<"$row"
        [[ -n "$AGENT_FILTER" && "$AGENT_FILTER" != "$agent" ]] && continue
        # Removing mAId's own kiro entry is a file edit; it needs no kiro.
        if ! have "$cli" && ! [[ "$agent" == kiro && "$op" == uninstall && -e "$KIRO_MCP" ]]; then
            skip "$agent ($cli not on PATH)"
            record_skip "$op" "$agent" "$cli not on PATH"
            continue
        fi
        if [[ "$agent" == kiro ]] && ! have jq; then
            skip "$agent (jq not on PATH)"
            record_skip "$op" "$agent" "jq not on PATH"
            continue
        fi
        case "$op" in
            install)   op_install "$agent" "$style" ;;
            uninstall) op_uninstall "$agent" ;;
            status)    op_status "$agent" ;;
        esac
    done
}

# Tell mAId's part list what is now registered on <agent>: the server's
# name, `--skipped <why>` with it, or nothing to clear it. See project.md
# "My harness".
# A failure is reported and fails the run at the end, so the other agents
# are still done.
record() {
    local agent="$1"
    shift
    local args=(record --agent "$agent" --kind mcp --only "$SERVER_NAME")
    cargo run -p build-tool --release --quiet -- "${args[@]}" "$@" || {
        skip "$(label "$agent") (part list not updated)"
        RECORD_FAILED=1
    }
}

# A skip on install is recorded with its reason; on uninstall it clears.
record_skip() {
    case "$1" in
        install)   record "$2" --skipped "$3" "$SERVER_NAME" ;;
        uninstall) record "$2" ;;
    esac
}

# A same-named server mAId did not write (kiro only: claude and codex
# are still matched by name).
not_ours() { [[ "$1" == kiro && "$(kiro_state)" == other ]]; }
is_bad() { [[ "$1" == kiro && "$(kiro_state)" == bad ]]; }

# Left-pad the agent name so multi-agent output stays column-aligned.
label() { printf '%-6s' "$1"; }

op_install() {
    local agent="$1" style="$2" out
    if not_ours "$agent"; then
        skip "$(label "$agent") ($SERVER_NAME is not mAId's; left in place)"
        record "$agent" --skipped "not mAId's" "$SERVER_NAME"
        return
    fi
    # An earlier install's registration is still there without Chrome.
    if [[ -n "${NO_CHROME:-}" ]]; then
        if mcp_get "$agent"; then
            record "$agent" "$SERVER_NAME"
        else
            record "$agent" --skipped "no graphical Chrome" "$SERVER_NAME"
        fi
        return
    fi
    # readd agents error on a duplicate name; clear it first so a
    # re-run refreshes rather than fails.
    if [[ "$style" == readd ]]; then
        mcp_remove "$agent" >/dev/null 2>&1 || true
    fi
    if out="$(mcp_add "$agent" 2>&1)"; then
        ok "$(label "$agent") ($SERVER_NAME → $LAUNCHER)"
        record "$agent" "$SERVER_NAME"
    else
        # Surface the CLI's own first line (e.g. "not logged in") so
        # the skip is actionable.
        skip "$(label "$agent") (mcp add failed: $(printf '%s' "$out" | head -n1))" >&2
        # The list stays path-free and byte-stable; the CLI's words are above.
        record "$agent" --skipped "mcp add failed" "$SERVER_NAME"
    fi
}

op_uninstall() {
    local agent="$1"
    # Whether mAId's entry is in there is unknown, so the list stays as it is.
    if is_bad "$agent"; then
        skip "$(label "$agent") (kiro's global MCP config is not one JSON object; left in place)"
        return
    fi
    if not_ours "$agent"; then
        info "$(label "$agent") ($SERVER_NAME is not mAId's; left in place)"
        record "$agent"
        return
    fi
    # codex's `mcp remove` exits 0 whether or not the server existed,
    # so gate its "removed" claim on a prior registration check to
    # avoid a misleading message on a clean machine. claude/kiro
    # return nonzero when absent, so their branch is already honest.
    if [[ "$agent" == codex ]] && ! mcp_get "$agent"; then
        mcp_remove "$agent" >/dev/null 2>&1 || true
        info "$(label "$agent") ($SERVER_NAME not registered)"
        record "$agent"
        return
    fi
    if mcp_remove "$agent" >/dev/null 2>&1; then
        ok "$(label "$agent") (removed $SERVER_NAME)"
    else
        info "$(label "$agent") ($SERVER_NAME not registered)"
    fi
    # A remove that failed for another reason leaves it registered.
    if mcp_get "$agent"; then record "$agent" "$SERVER_NAME"; else record "$agent"; fi
}

op_status() {
    local agent="$1"
    if mcp_get "$agent"; then
        ok "$(label "$agent") ($SERVER_NAME registered)"
    elif not_ours "$agent"; then
        info "$(label "$agent") ($SERVER_NAME registered, not mAId's)"
    elif is_bad "$agent"; then
        info "$(label "$agent") (kiro's global MCP config is not one JSON object)"
    else
        info "$(label "$agent") ($SERVER_NAME not registered)"
    fi
}

# ── kiro's global config ─────────────────────────────────────────
# Only mAId's entry is touched; every other key keeps its value. The
# single-quoted $n and $c are jq's variables, hence the SC2016 waivers.

# absent | ours (its command is the launcher) | other | bad (not one
# JSON object). A missing or empty file is absent.
# shellcheck disable=SC2016
kiro_state() {
    [[ -s "$KIRO_MCP" ]] || { echo absent; return; }
    jq -rs --arg n "$SERVER_NAME" --arg c "$LAUNCHER" '
        if length != 1 or (.[0] | type) != "object" then "bad"
        else .[0].mcpServers[$n] as $e
            | if $e == null then "absent"
              elif ($e | type) == "object" and $e.command == $c then "ours"
              else "other" end
        end' "$KIRO_MCP" 2>/dev/null || echo bad
}

# The file a linked config points at; the link itself is left a link.
# A link cycle fails rather than looping.
kiro_target() {
    local t="$KIRO_MCP" l n=0
    while [[ -L "$t" ]]; do
        ((++n <= 40)) || { echo "kiro's global MCP config is a link cycle" >&2; return 1; }
        l="$(readlink "$t")"
        if [[ "$l" == /* ]]; then t="$l"; else t="$(dirname "$t")/$l"; fi
    done
    printf '%s\n' "$t"
}

# Apply jq filter $1 to the config, and write only when the result
# differs as JSON. Atomic: a temp file beside the target, with its mode,
# renamed over it, since the file holds other tools' servers.
# shellcheck disable=SC2016
kiro_edit() {
    local target tmp rc=0
    target="$(kiro_target)" || return
    mkdir -p "$(dirname "$target")" || return
    tmp="$(mktemp "$(dirname "$target")/.mcp.json.XXXXXX")" || return
    if [[ -e "$target" ]]; then
        cp -p "$target" "$tmp"
    else
        chmod "$(printf '%o' $((8#666 & ~8#$(umask))))" "$tmp"
    fi || rc=$?
    # `>` keeps the temp file's mode.
    ((rc == 0)) && { { if [[ -s "$target" ]]; then cat "$target"; else echo '{}'; fi; } \
        | jq --arg n "$SERVER_NAME" --arg c "$LAUNCHER" "$1" >"$tmp"; } || rc=$?
    if ((rc == 0)) && ! { [[ -s "$target" ]] \
        && jq -en --slurpfile a "$tmp" --slurpfile b "$target" '$a == $b' >/dev/null; }; then
        mv -f "$tmp" "$target" || rc=$?
    fi
    rm -f "$tmp"
    return "$rc"
}

# shellcheck disable=SC2016
kiro_add() {
    if [[ "$(kiro_state)" == bad ]]; then
        echo "kiro's global MCP config is not one JSON object"
        return 1
    fi
    # Merged, so a key the user set on mAId's entry (`disabled`) stays.
    kiro_edit '.mcpServers[$n] = ((.mcpServers[$n] // {}) + {command: $c, args: []})'
}

# shellcheck disable=SC2016
kiro_remove() {
    [[ "$(kiro_state)" == ours ]] || return 1
    kiro_edit 'del(.mcpServers[$n])'
}

# ── leaf dispatchers: the only per-CLI-different code ─────────────

mcp_add() {
    case "$1" in
        claude) claude   mcp add -s user "$SERVER_NAME" -- "$LAUNCHER" ;;
        kiro)   kiro_add ;;
        codex)  codex    mcp add "$SERVER_NAME" -- "$LAUNCHER" ;;
    esac
}

mcp_remove() {
    case "$1" in
        claude) claude   mcp remove -s user "$SERVER_NAME" ;;
        kiro)   kiro_remove ;;
        codex)  codex    mcp remove "$SERVER_NAME" ;;
    esac
}

# 0 = registered (for kiro: and mAId's).
mcp_get() {
    case "$1" in
        claude) claude mcp get "$SERVER_NAME" >/dev/null 2>&1 ;;
        codex)  codex  mcp get "$SERVER_NAME" >/dev/null 2>&1 ;;
        kiro)   [[ "$(kiro_state)" == ours ]] ;;
    esac
}

# ── subcommands ──────────────────────────────────────────────────

cmd_install() {
    LAUNCHER="${1:?manage install: launcher path required}"
    AGENT_FILTER="${2:-}"
    validate_agent_filter "$AGENT_FILTER"
    # A missing launcher means the profile was never built — hard-fail
    # to stderr, unlike the graceful prereq skips below.
    [[ -x "$LAUNCHER" ]] || { printf 'manage: launcher not executable: %s (run: just install)\n' "$LAUNCHER" >&2; exit 1; }

    if ! chrome_present; then
        skip "install-browser-mcp (no graphical Chrome found — desktop only)"
        NO_CHROME=1 mcp_foreach install
        [[ -z "${RECORD_FAILED:-}" ]]
        return
    fi
    mcp_foreach install

    printf '\nOne-time browser setup (do this once, by hand):\n'
    info "open chrome://inspect/#remote-debugging in Chrome, enable remote"
    info "debugging, and accept the permission prompt the first time the"
    info "agent attaches."
    printf '\nAllowlist (deny-by-default — add at least one site before use):\n'
    info "$ALLOWLIST"
    info "edit directly, or: just resources::browser-mcp-allow '<pattern>'"
    [[ -z "${RECORD_FAILED:-}" ]]
}

cmd_uninstall() {
    LAUNCHER="${1:?manage uninstall: launcher path required}"
    AGENT_FILTER="${2:-}"
    validate_agent_filter "$AGENT_FILTER"
    mcp_foreach uninstall
    info "allowlist left in place (user data): $ALLOWLIST"
    [[ -z "${RECORD_FAILED:-}" ]]
}

cmd_status() {
    LAUNCHER="${1:?manage status: launcher path required}"
    AGENT_FILTER="${2:-}"
    validate_agent_filter "$AGENT_FILTER"
    mcp_foreach status
    if [[ -s "$ALLOWLIST" ]]; then
        local n
        n="$(grep -cvE '^\s*(#|$)' "$ALLOWLIST" || true)"
        info "allowlist: $n pattern(s) in $ALLOWLIST"
    else
        info "allowlist: empty/absent ($ALLOWLIST) — capability denies all until a site is added"
    fi
}

cmd_allow() {
    local pattern="${1:?manage allow: pattern required}"
    mkdir -p "$(dirname "$ALLOWLIST")"
    printf '%s\n' "$pattern" >>"$ALLOWLIST"
    ok "added to $ALLOWLIST: $pattern"
    info "takes effect on the next browser-control session (Chrome is not restarted)"
}

# ── dispatch ─────────────────────────────────────────────────────

sub="${1:-}"; shift || true
case "$sub" in
    install)   cmd_install "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    status)    cmd_status "$@" ;;
    allow)     cmd_allow "$@" ;;
    *) printf 'manage: unknown subcommand %q (want: install|uninstall|status|allow)\n' "$sub" >&2; exit 2 ;;
esac
