# Resources verbs operate on $HOME — they read or write the
# symlinks the AI tools consume. Validation of content runs
# inside `install`. Recipes invoke from the workspace root
# (via `[no-cd]`), so `cargo run -p build-tool` and
# `resources/tests/run` resolve against the same paths as
# the legacy flat Justfile.

# Validate content and create/refresh $HOME-facing skill symlinks.
# First arg is the coding-agent selector (claude|kiro|codex; omit for
# all three); remaining flags pass through, e.g.
#   just resources::install-skills                 (all agents)
#   just resources::install-skills codex           (codex only)
#   just resources::install-skills codex --force   (codex, repoint)
#   just resources::install-skills --force         (all agents, repoint)
# The `=~ '^-'` guard lets a leading flag (no agent given) pass through
# as a flag rather than being mistaken for an agent name.
[no-cd]
install-skills agent="" *FLAGS:
    cargo run -p build-tool --release --quiet -- install {{ if agent =~ '^-' { agent } else if agent != "" { "--agent " + agent } else { "" } }} {{ FLAGS }}

# Remove install-managed skill symlinks (optionally for one agent).
[no-cd]
uninstall-skills agent="" *FLAGS:
    cargo run -p build-tool --release --quiet -- uninstall {{ if agent =~ '^-' { agent } else if agent != "" { "--agent " + agent } else { "" } }} {{ FLAGS }}

# Report each managed skill symlink's state (optionally for one agent).
[no-cd]
status-skills agent="":
    cargo run -p build-tool --release --quiet -- status {{ if agent != "" { "--agent " + agent } else { "" } }}

# Drive the AI tools (claude --print, kiro-cli) against the
# installed content to confirm skills load correctly. Costs API
# credits and takes minutes — gated behind a confirmation prompt.
[confirm("This costs API credits and takes minutes. Continue? (y/N)")]
[no-cd]
verify:
    resources/tests/run

# Drive a single fixture (e.g. `just resources::verify-one kdevkit`).
[no-cd]
verify-one name:
    resources/tests/run "{{ name }}"

# ── browser-control MCP ──────────────────────────────────────────
# Register Google's chrome-devtools-mcp with the installed agent
# harnesses, launched via resources/browser/launch so the user's
# allowlist is enforced. The register/report verbs follow the
# `<action>-browser-mcp` pattern so they read as peers of the
# `*-skills` verbs (`browser-mcp-allow` keeps its name — it manages
# the allowlist, not the registration lifecycle). Desktop-only;
# graceful skip where there is no GUI Chrome, no nix, or no harness
# CLI. The allowlist is user-owned data — uninstall never touches it.
#
# Every verb takes the uniform coding-agent selector as its first
# argument (claude|kiro|codex; omit for all three). Kiro partitions
# MCP servers per named sub-agent, so targeting kiro also needs a
# trailing sub-agent name; omit it and kiro is skipped (claude and
# codex are global — their server is visible to every session).

# Register the browser-control server. e.g.
#   just resources::install-browser-mcp             (all three)
#   just resources::install-browser-mcp codex       (codex only)
#   just resources::install-browser-mcp kiro my-sub  (kiro sub-agent)
[no-cd]
install-browser-mcp agent="" kiro_sub="":
    resources/browser/manage install "{{ source_directory() }}/browser/launch" "{{ agent }}" "{{ kiro_sub }}"

# Remove the browser-control server registration (keeps allowlist).
[no-cd]
uninstall-browser-mcp agent="" kiro_sub="":
    resources/browser/manage uninstall "{{ agent }}" "{{ kiro_sub }}"

# Report browser-control registration state and allowlist size.
[no-cd]
status-browser-mcp agent="" kiro_sub="":
    resources/browser/manage status "{{ agent }}" "{{ kiro_sub }}"

# Append a site pattern to the allowlist verbatim (hand-edit fallback).
[no-cd]
browser-mcp-allow pattern:
    resources/browser/manage allow "{{ pattern }}"

# ATTENDED functional test: drive claude/kiro to open real Chrome
# via the browser MCP against an isolated allowlist, and confirm an
# off-list site is blocked. Takes control of your browser — run it
# by hand. Requires browser-mcp-install + Chrome remote debugging.
# Kiro is tested only when its agent name is given (the agent that
# carries the chrome-devtools server). e.g.
#   just resources::browser-functional-test claude
#   just resources::browser-functional-test kiro my-agent
[confirm("This drives your real Chrome through claude/kiro. Chrome must be running with remote debugging enabled. Continue? (y/N)")]
[no-cd]
browser-functional-test tool="" kiro_agent="":
    resources/tests/browser-functional {{ tool }} {{ if kiro_agent != "" { "--kiro-agent=" + kiro_agent } else { "" } }}
