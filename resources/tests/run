#!/usr/bin/env bash
# mAId/resources/tests/run — functional smoke tests.
#
# Exercises AI artefacts (skills + AGENTS.md preamble) in the
# real tools (Claude Code, Kiro) and asserts each one round-trips.
#
# Invoked via Justfile recipes — `just test-smoke` (no API calls,
# structural only), `just test-functional` (full), or
# `just test-fixture <name>` for a single fixture. Direct invocation
# also works.
#
# Fixture shape — one file per artefact:
#   resources/tests/skills/<name>.smoke     Generic format:
#     prompt: <one-line prompt>
#     expect_substr: <substring the response must contain>
#     expected_narrative: <prose describing what a correct
#                          answer should cover; triggers a
#                          second judge call on the same tool>
#     tools: claude,kiro       (optional; defaults to "claude")
#
#   Each fixture must declare prompt: plus at least one of
#   expect_substr: or expected_narrative:. Both may be set
#   (substring is checked first, then the judge).
#
# Cheap structural checks (symlink resolves, files exist) run
# first. Real tool invocations follow — those can be slow.
# Missing CLIs skip (don't fail) their respective assertions.
#
# Usage:
#   resources/tests/run                 Run all smokes.
#   resources/tests/run --no-tools      Skip the claude/kiro
#                                       invocations; only
#                                       structural checks.
#   resources/tests/run --stressed      Prepend the shared
#                                       conversational-stream
#                                       prefix to each fixture's
#                                       prompt. Stresses whether
#                                       the agent retains the
#                                       skill contract under a
#                                       long-session content load.
#                                       Both modes evaluate the
#                                       same expected_narrative.
#   resources/tests/run <name>          Run only <name>'s smoke.
#   resources/tests/run --help

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# -P so the path is the physical/realpath form. Home-dir auto-mounts
# (e.g. /home/user → /local/home/user) would otherwise misalign with
# `readlink -f` output from the assertion helpers.
MAID_ROOT="$(cd -P "$HERE/../.." && pwd -P)"

# ── args ────────────────────────────────────────────────────────────

NO_TOOLS=0
STRESSED=0
SELECTOR=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-tools) NO_TOOLS=1; shift ;;
        --stressed) STRESSED=1; shift ;;
        --help|-h)
            awk '/^$/{exit} /^#/{sub(/^# ?/,""); print}' "${BASH_SOURCE[0]}"
            exit 0
            ;;
        -*) echo "unknown flag: $1" >&2; exit 2 ;;
        *)  SELECTOR="$1"; shift ;;
    esac
done

# Load the conversational-stream prefix once if --stressed.
# The prefix is treated as literal text — it must not contain
# unescaped `$`, backticks, or backslash sequences, since the
# concatenation below keeps it inside double quotes. Today's
# prefix is plain English; future authors editing
# conversational-stream.txt should keep it that way or quote
# any shell-active characters.
STRESS_PREFIX=""
if (( STRESSED )); then
    if [[ ! -r "$HERE/conversational-stream.txt" ]]; then
        echo "--stressed requires $HERE/conversational-stream.txt" >&2
        exit 2
    fi
    STRESS_PREFIX="$(cat "$HERE/conversational-stream.txt")"
fi

# ── output ──────────────────────────────────────────────────────────

pass() { printf '\033[32mPASS\033[0m %s\n' "$*"; }
fail() { printf '\033[31mFAIL\033[0m %s\n' "$*" >&2; FAILURES=$((FAILURES+1)); }
skip() { printf '\033[33mSKIP\033[0m %s\n' "$*"; }
info() { printf '  %s\n' "$*"; }

FAILURES=0

# ── assertions ──────────────────────────────────────────────────────

# assert_symlink_resolves <path> <expected-absolute-target>
assert_symlink_resolves() {
    local path="$1" expected="$2"
    if [[ ! -L "$path" ]]; then
        fail "$path is not a symlink"
        return
    fi
    local actual
    actual="$(readlink -f "$path" 2>/dev/null || true)"
    if [[ "$actual" != "$expected" ]]; then
        fail "$path resolves to $actual (expected $expected)"
        return
    fi
    pass "$path resolves"
}

# tool_invoke <tool> <prompt>   → echoes captured stdout/stderr.
# Returns 0 on tool exit success, 1 on invocation failure (caller
# distinguishes by checking the return code; the captured text is
# still echoed so the caller can include it in the failure
# message).
tool_invoke() {
    local tool="$1" prompt="$2"
    case "$tool" in
        claude) claude --print --dangerously-skip-permissions "$prompt" 2>&1 ;;
        kiro)   kiro-cli chat --no-interactive --trust-tools= "$prompt" 2>&1 ;;
        *)      echo "tool_invoke: unknown tool '$tool'"; return 1 ;;
    esac
}

# tool_available <tool>   → 0 if on PATH, 1 otherwise.
tool_available() {
    case "$1" in
        claude) command -v claude   >/dev/null 2>&1 ;;
        kiro)   command -v kiro-cli >/dev/null 2>&1 ;;
        *)      return 1 ;;
    esac
}

# build_judge_prompt <question> <answer> <expected-narrative>
build_judge_prompt() {
    local question="$1" answer="$2" expected="$3"
    cat <<EOF
You are evaluating whether an AI agent's answer is consistent with a skill's intended narrative.

Question:
$question

Answer:
$answer

Expected narrative:
$expected

Reply with exactly one line in this format:
PASS — <one short sentence describing what's right>
or
FAIL — <one short sentence describing what's missing or wrong>
EOF
}

# assert_response <tool> <prompt> <expect-substr-or-empty>
#                 <expected-narrative-or-empty> <check-name>
#
# Runs the prompt through <tool>. If expect-substr is non-empty,
# checks substring first. If expected-narrative is non-empty,
# runs a second judge call on the same tool. Either check
# missing → its phase is skipped. At least one must be set
# (validated by the caller).
assert_response() {
    local tool="$1" prompt="$2" expect_substr="$3"
    local expected_narrative="$4" name="$5"

    if ! tool_available "$tool"; then
        skip "$name ($tool not on PATH)"
        return
    fi

    local out
    if ! out="$(tool_invoke "$tool" "$prompt")"; then
        fail "$name ($tool invocation failed): $out"
        return
    fi

    if [[ -n "$expect_substr" ]]; then
        if grep -qiF -- "$expect_substr" <<<"$out"; then
            pass "$name (substr)"
        else
            fail "$name (substr): response missing '$expect_substr'"
            info "response head: $(head -c 200 <<<"$out")..."
            return
        fi
    fi

    if [[ -n "$expected_narrative" ]]; then
        local judge_prompt judge_out judge_clean verdict
        judge_prompt="$(build_judge_prompt "$prompt" "$out" "$expected_narrative")"
        if ! judge_out="$(tool_invoke "$tool" "$judge_prompt")"; then
            fail "$name (judge invocation failed): $judge_out"
            return
        fi
        # Strip ANSI escape codes and control bytes, then look for
        # the first PASS/FAIL token anywhere in the response.
        # Different tools prefix lines differently (e.g. kiro emits
        # `> PASS — ...`); anchoring to ^ is too strict. Some kiro
        # outputs split a long verdict across multiple `> `-prefixed
        # lines, so collapse newlines to spaces before grepping.
        judge_clean="$(printf '%s' "$judge_out" \
            | sed -E 's/\x1b\[[0-9;]*[a-zA-Z]//g; s/\r//g' \
            | tr '\n' ' ')"
        verdict="$(grep -oE '(PASS|FAIL)[^|]+' <<<"$judge_clean" | head -n1 || true)"
        case "$verdict" in
            PASS*)
                pass "$name (judge)"
                info "${verdict#PASS — }"
                ;;
            FAIL*)
                fail "$name (judge): ${verdict#FAIL — }"
                info "answer head: $(head -c 200 <<<"$out")..."
                ;;
            *)
                local dump="/tmp/smoke-judge-${name//[^a-zA-Z0-9_-]/_}-${tool}.log"
                printf '%s\n' "$judge_clean" >"$dump"
                fail "$name (judge): no PASS/FAIL token; full judge output → $dump"
                info "judge head: $(head -c 200 <<<"$judge_clean")..."
                ;;
        esac
    fi
}

# ── structural smokes ──────────────────────────────────────────────

structural_smokes() {
    info "=== structural checks ==="
    # Belt-and-suspenders: legacy CLAUDE.md/KIRO.md and AGENTS.md all
    # symlink at the same merged source — resources/content/agents.md.
    assert_symlink_resolves "$HOME/.claude/CLAUDE.md"        "$MAID_ROOT/resources/content/agents.md"
    assert_symlink_resolves "$HOME/.claude/AGENTS.md"        "$MAID_ROOT/resources/content/agents.md"
    assert_symlink_resolves "$HOME/.kiro/steering/KIRO.md"   "$MAID_ROOT/resources/content/agents.md"
    assert_symlink_resolves "$HOME/.kiro/steering/AGENTS.md" "$MAID_ROOT/resources/content/agents.md"
    # Directory symlinks: readlink -f resolves to the target dir.
    assert_symlink_resolves "$HOME/.claude/skills"           "$MAID_ROOT/resources/content/skills"
    assert_symlink_resolves "$HOME/.kiro/steering/skills"    "$MAID_ROOT/resources/content/skills"

    # Each skill's SKILL.md exists and is reachable through the symlink.
    local skill
    for skill in "$MAID_ROOT/resources/content/skills"/*/SKILL.md; do
        [[ -e "$skill" ]] || continue
        local name
        name="$(basename "$(dirname "$skill")")"
        [[ -n "$SELECTOR" && "$SELECTOR" != "$name" ]] && continue
        local homepath="$HOME/.claude/skills/$name/SKILL.md"
        if [[ -r "$homepath" ]]; then
            pass "skill visible: $name"
        else
            fail "skill not reachable through ~/.claude/skills/$name"
        fi
    done
}

# ── skill-level functional smokes ──────────────────────────────────

skill_smokes() {
    info "=== skill smokes ==="
    local fixture name prompt expect_substr expected_narrative tools tool
    for fixture in "$HERE/skills"/*.smoke; do
        [[ -e "$fixture" ]] || continue
        name="$(basename "$fixture" .smoke)"
        [[ -n "$SELECTOR" && "$SELECTOR" != "$name" ]] && continue

        prompt="$(grep '^prompt:' "$fixture" | sed 's/^prompt:[[:space:]]*//')"
        expect_substr="$(grep '^expect_substr:' "$fixture" | sed 's/^expect_substr:[[:space:]]*//' || true)"
        expected_narrative="$(grep '^expected_narrative:' "$fixture" | sed 's/^expected_narrative:[[:space:]]*//' || true)"
        tools="$(grep '^tools:' "$fixture" | sed 's/^tools:[[:space:]]*//')"
        : "${tools:=claude}"
        if [[ -z "$prompt" ]]; then
            fail "fixture $fixture malformed (missing prompt:)"
            continue
        fi
        # In --stressed mode, prepend the shared conversational-stream
        # prefix verbatim. The prefix ends with "Now the user says:"
        # so the per-fixture prompt becomes the user's "current" turn
        # at the end of a long session. Newline-join so the per-fixture
        # prompt sits on its own line below "Now the user says:".
        if (( STRESSED )); then
            prompt="$STRESS_PREFIX"$'\n'"$prompt"
        fi
        if [[ -z "$expect_substr" && -z "$expected_narrative" ]]; then
            fail "fixture $fixture malformed (needs expect_substr: or expected_narrative:)"
            continue
        fi
        IFS=',' read -ra _tool_list <<<"$tools"
        for tool in "${_tool_list[@]}"; do
            tool="${tool//[[:space:]]/}"
            case "$tool" in
                claude|kiro)
                    assert_response "$tool" "$prompt" "$expect_substr" \
                        "$expected_narrative" "skill:$name via $tool"
                    ;;
                "") ;;
                *)  fail "fixture $fixture: unknown tool '$tool' in tools: field" ;;
            esac
        done
    done
}

# ── flow ────────────────────────────────────────────────────────────

structural_smokes
if (( NO_TOOLS )); then
    skip "tool invocations disabled (--no-tools)"
else
    skill_smokes
fi

echo
if (( FAILURES == 0 )); then
    echo "all smokes passed"
    exit 0
else
    echo "$FAILURES smoke(s) failed"
    exit 1
fi
