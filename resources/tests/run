#!/usr/bin/env bash
# mAId/resources/tests/run — drives the AI tools against installed
# content. The Justfile invokes this as `just verify` (or
# `just verify-one <name>`).
#
# Pre-condition: `just install` has run, so $HOME has the managed
# symlinks. Structural correctness of the install is covered by
# `cargo test` against tempfile-fake-HOME — this script ONLY
# exercises behavior in the real AI tools.
#
# Fixture shape — one file per artefact:
#   resources/tests/skills/<name>.smoke
#     prompt: <one-line prompt>
#     tools: claude,kiro,codex   (optional; defaults to "claude")
#
#   Then ONE of two verification styles:
#
#   (a) Judge / substring — tests what the agent SAYS:
#     expect_substr: <substring the response must contain>
#     expected_narrative: <prose a correct answer should cover;
#                          triggers a second judge call on the tool>
#
#   (b) Behavioral — tests what the agent DOES. Fenced shell blocks
#       run before/after the agent, which is driven inside a fresh
#       scratch repo with write access:
#     --- setup ---
#     <shell that seeds the scratch repo (cwd = the repo)>
#     --- assert ---
#     <shell that inspects the working tree after the agent runs;
#      non-zero exit = fail>
#
#   A behavioral fixture (has an --- assert --- block) uses style (b);
#   otherwise it needs expect_substr: or expected_narrative:.
#
# Required tools (claude, kiro, codex) fail when absent; other tools
# skip. A skill that drives all three to the same artefacts is robust.
#
# Usage:
#   resources/tests/run                 Run every fixture.
#   resources/tests/run <name>          Run only <name>'s fixture.
#   resources/tests/run --stressed      Prepend the shared
#                                       conversational-stream prefix
#                                       to each fixture's prompt to
#                                       stress retention under load.
#   resources/tests/run --help

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── args ────────────────────────────────────────────────────────────

STRESSED=0
SELECTOR=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --stressed) STRESSED=1; shift ;;
        --help|-h)
            awk '/^$/{exit} /^#/{sub(/^# ?/,""); print}' "${BASH_SOURCE[0]}"
            exit 0
            ;;
        -*) echo "unknown flag: $1" >&2; exit 2 ;;
        *)  SELECTOR="$1"; shift ;;
    esac
done

STRESS_PREFIX=""
if (( STRESSED )); then
    if [[ ! -r "$HERE/conversational-stream.txt" ]]; then
        echo "--stressed requires $HERE/conversational-stream.txt" >&2
        exit 2
    fi
    STRESS_PREFIX="$(cat "$HERE/conversational-stream.txt")"
fi

# ── output ──────────────────────────────────────────────────────────

pass() { printf '\033[32mPASS\033[0m %s\n' "$*"; }
fail() { printf '\033[31mFAIL\033[0m %s\n' "$*" >&2; FAILURES=$((FAILURES+1)); }
skip() { printf '\033[33mSKIP\033[0m %s\n' "$*"; }
info() { printf '  %s\n' "$*"; }

FAILURES=0

# ── tool plumbing ───────────────────────────────────────────────────

# tool_invoke <tool> <prompt> [workdir] → echoes captured stdout/stderr.
#
# The single indirection point for driving a coding agent
# non-interactively. Per-tool CLI flags change across versions; when
# they do, this is the only function to touch. When <workdir> is given
# the agent runs there with write access (behavioral fixtures that seed
# a scratch repo); without it, agents run read-only for cheap
# load-checks.
tool_invoke() {
    local tool="$1" prompt="$2" workdir="${3:-}"
    case "$tool" in
        claude)
            if [[ -n "$workdir" ]]; then
                (cd "$workdir" && claude --print --dangerously-skip-permissions "$prompt" 2>&1)
            else
                claude --print --dangerously-skip-permissions "$prompt" 2>&1
            fi
            ;;
        kiro)
            if [[ -n "$workdir" ]]; then
                (cd "$workdir" && kiro-cli chat --no-interactive --trust-all-tools "$prompt" 2>&1)
            else
                kiro-cli chat --no-interactive --trust-tools= "$prompt" 2>&1
            fi
            ;;
        codex)
            # `exec` is codex's non-interactive mode. stdin must be closed
            # or it waits for more input. --skip-git-repo-check because a
            # seeded scratch repo may not be a git tree. read-only for
            # load-checks; workspace-write when a workdir is seeded.
            if [[ -n "$workdir" ]]; then
                codex exec --cd "$workdir" --sandbox workspace-write \
                    --skip-git-repo-check "$prompt" </dev/null 2>&1
            else
                codex exec --sandbox read-only \
                    --skip-git-repo-check "$prompt" </dev/null 2>&1
            fi
            ;;
        *)      echo "tool_invoke: unknown tool '$tool'"; return 1 ;;
    esac
}

tool_available() {
    case "$1" in
        claude) command -v claude   >/dev/null 2>&1 ;;
        kiro)   command -v kiro-cli >/dev/null 2>&1 ;;
        codex)  command -v codex    >/dev/null 2>&1 ;;
        *)      return 1 ;;
    esac
}

# Tools whose absence is a hard failure, not a skip. codex, kiro, and
# claude are all expected in this environment; a missing required tool
# reds the suite (per the feature's "verify across three agents" goal).
REQUIRED_TOOLS="claude kiro codex"

tool_required() {
    [[ " $REQUIRED_TOOLS " == *" $1 "* ]]
}

build_judge_prompt() {
    local question="$1" answer="$2" expected="$3"
    cat <<EOF
You are evaluating whether an AI agent's answer is consistent with a skill's intended narrative.

Question:
$question

Answer:
$answer

Expected narrative:
$expected

Reply with exactly one line in this format:
PASS — <one short sentence describing what's right>
or
FAIL — <one short sentence describing what's missing or wrong>
EOF
}

# assert_response <tool> <prompt> <expect-substr-or-empty>
#                 <expected-narrative-or-empty> <check-name>
assert_response() {
    local tool="$1" prompt="$2" expect_substr="$3"
    local expected_narrative="$4" name="$5"

    if ! tool_available "$tool"; then
        if tool_required "$tool"; then
            fail "$name ($tool required but not on PATH)"
        else
            skip "$name ($tool not on PATH)"
        fi
        return
    fi

    local out
    if ! out="$(tool_invoke "$tool" "$prompt")"; then
        fail "$name ($tool invocation failed): $out"
        return
    fi

    if [[ -n "$expect_substr" ]]; then
        if grep -qiF -- "$expect_substr" <<<"$out"; then
            pass "$name (substr)"
        else
            fail "$name (substr): response missing '$expect_substr'"
            info "response head: $(head -c 200 <<<"$out")..."
            return
        fi
    fi

    if [[ -n "$expected_narrative" ]]; then
        local judge_prompt judge_out judge_clean verdict
        judge_prompt="$(build_judge_prompt "$prompt" "$out" "$expected_narrative")"
        if ! judge_out="$(tool_invoke "$tool" "$judge_prompt")"; then
            fail "$name (judge invocation failed): $judge_out"
            return
        fi
        # Strip ANSI escape codes and control bytes, then look for
        # the first PASS/FAIL token anywhere in the response.
        judge_clean="$(printf '%s' "$judge_out" \
            | sed -E 's/\x1b\[[0-9;]*[a-zA-Z]//g; s/\r//g' \
            | tr '\n' ' ')"
        verdict="$(grep -oE '(PASS|FAIL)[^|]+' <<<"$judge_clean" | head -n1 || true)"
        case "$verdict" in
            PASS*)
                pass "$name (judge)"
                info "${verdict#PASS — }"
                ;;
            FAIL*)
                fail "$name (judge): ${verdict#FAIL — }"
                info "answer head: $(head -c 200 <<<"$out")..."
                ;;
            *)
                local dump="/tmp/verify-judge-${name//[^a-zA-Z0-9_-]/_}-${tool}.log"
                printf '%s\n' "$judge_clean" >"$dump"
                fail "$name (judge): no PASS/FAIL token; full judge output → $dump"
                info "judge head: $(head -c 200 <<<"$judge_clean")..."
                ;;
        esac
    fi
}

# extract_block <marker> <file> → the lines of a fenced block, where a
# block is introduced by `--- <marker> ---` on its own line and runs to
# the next `--- ... ---` fence or EOF. Used for the multi-line setup:
# and assert: shell of behavioral fixtures.
extract_block() {
    awk -v want="--- $1 ---" '
        $0 == want { grab = 1; next }
        /^--- .* ---$/ { grab = 0 }
        grab { print }
    ' "$2"
}

# assert_behavioral <tool> <prompt> <setup> <assert> <check-name>
#
# Seeds a fresh scratch repo, runs the agent inside it with write
# access, then runs the assert shell against the resulting working
# tree. A non-zero assert exit is a fail — the agent didn't produce
# the artefacts the methodology requires. Tests execution, not recall.
assert_behavioral() {
    local tool="$1" prompt="$2" setup="$3" assert="$4" name="$5"

    if ! tool_available "$tool"; then
        if tool_required "$tool"; then
            fail "$name ($tool required but not on PATH)"
        else
            skip "$name ($tool not on PATH)"
        fi
        return
    fi

    local work
    work="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap "rm -rf '$work'" RETURN

    if ! ( cd "$work" && bash -c "$setup" ) >/tmp/verify-setup.log 2>&1; then
        fail "$name (setup failed): $(head -c 200 /tmp/verify-setup.log)"
        return
    fi

    local out
    out="$(tool_invoke "$tool" "$prompt" "$work")" || true

    local alog
    alog="$(mktemp)"
    if ( cd "$work" && bash -c "$assert" ) >"$alog" 2>&1; then
        pass "$name (behavioral)"
    else
        fail "$name (behavioral): assert failed — $(head -c 200 "$alog")"
        info "agent output head: $(head -c 200 <<<"$out")..."
    fi
    rm -f "$alog"
}

# ── fixture loop ────────────────────────────────────────────────────

for fixture in "$HERE/skills"/*.smoke; do
    [[ -e "$fixture" ]] || continue
    name="$(basename "$fixture" .smoke)"
    [[ -n "$SELECTOR" && "$SELECTOR" != "$name" ]] && continue

    prompt="$(grep '^prompt:' "$fixture" | sed 's/^prompt:[[:space:]]*//')"
    expect_substr="$(grep '^expect_substr:' "$fixture" | sed 's/^expect_substr:[[:space:]]*//' || true)"
    expected_narrative="$(grep '^expected_narrative:' "$fixture" | sed 's/^expected_narrative:[[:space:]]*//' || true)"
    tools="$(grep '^tools:' "$fixture" | sed 's/^tools:[[:space:]]*//')"
    : "${tools:=claude}"

    # Behavioral fixtures carry fenced setup + assert shell blocks;
    # judge/substr fixtures carry expect_substr / expected_narrative.
    setup_block="$(extract_block setup "$fixture")"
    assert_block="$(extract_block assert "$fixture")"
    behavioral=0
    [[ -n "$setup_block" || -n "$assert_block" ]] && behavioral=1

    if [[ -z "$prompt" ]]; then
        fail "fixture $fixture malformed (missing prompt:)"
        continue
    fi
    if (( STRESSED )); then
        prompt="$STRESS_PREFIX"$'\n'"$prompt"
    fi
    if (( behavioral )); then
        if [[ -z "$assert_block" ]]; then
            fail "fixture $fixture malformed (behavioral needs an --- assert --- block)"
            continue
        fi
    elif [[ -z "$expect_substr" && -z "$expected_narrative" ]]; then
        fail "fixture $fixture malformed (needs expect_substr:, expected_narrative:, or an --- assert --- block)"
        continue
    fi
    IFS=',' read -ra _tool_list <<<"$tools"
    for tool in "${_tool_list[@]}"; do
        tool="${tool//[[:space:]]/}"
        case "$tool" in
            claude|kiro|codex)
                if (( behavioral )); then
                    assert_behavioral "$tool" "$prompt" "$setup_block" \
                        "$assert_block" "skill:$name via $tool"
                else
                    assert_response "$tool" "$prompt" "$expect_substr" \
                        "$expected_narrative" "skill:$name via $tool"
                fi
                ;;
            "") ;;
            *)  fail "fixture $fixture: unknown tool '$tool' in tools: field" ;;
        esac
    done
done

echo
if (( FAILURES == 0 )); then
    echo "all fixtures passed"
    exit 0
else
    echo "$FAILURES fixture(s) failed"
    exit 1
fi
