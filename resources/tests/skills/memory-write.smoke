skill: memory
tools: claude,kiro,codex
config_home: cfg
--- enact ---
task: Actually do it, don't just describe. Remember this for future sessions: I want Makefiles indented with tabs, never spaces, because make rejects spaces.
--- setup ---
# Two configured stores; personal is the default. The config lives under
# the workdir (config_home), never the user's real one.
mkdir -p stores/personal/memory stores/work/memory cfg/my-harness/memory
cat > cfg/my-harness/memory/maid-harness.json <<JSON
{ "format": 1, "part": "maid-harness", "default": "personal",
  "stores": { "personal": "$PWD/stores/personal", "work": "$PWD/stores/work" } }
JSON
# An earlier memory that must survive, with its index line.
cat > stores/personal/memory/user_role.md <<'MD'
---
name: user role
description: the user is a hobbyist game developer
metadata:
  type: user
---

The user writes small games in their spare time.
MD
echo '- [user role](user_role.md) - hobbyist game developer' > stores/personal/memory/MEMORY.md
--- assert ---
set -e
m=stores/personal/memory
# Exactly one new memory file beside the seeded one, about tabs.
new=$(ls "$m" | grep -v -x -e MEMORY.md -e user_role.md)
test "$(printf '%s\n' "$new" | grep -c .)" -eq 1
f="$m/$new"
grep -qi 'tab' "$f"
# Claude's own format: frontmatter with name, description, metadata.type.
head -1 "$f" | grep -qx -- '---'
grep -qE '^name: *[^ ]' "$f"
grep -qE '^description: *[^ ]' "$f"
grep -qE '^ +type: *(user|feedback|project|reference) *$' "$f"
# One index line links it, and the earlier line survives.
test "$(grep -cF "]($new)" "$m/MEMORY.md")" -eq 1
grep -qF '](user_role.md)' "$m/MEMORY.md"
grep -q 'hobbyist game developer' "$m/user_role.md"
# The non-default store got nothing.
test -z "$(ls -A stores/work/memory)"
