--- setup ---
git init -q
git config user.email t@t.t && git config user.name t
git checkout -q -b feat/add-due-dates
"$KDEVKIT_TOOLS/feature-loop" install >/dev/null
mkdir -p specs/feature
cat > specs/feature/add-due-dates.md <<'MD'
# Feature: add-due-dates

- Branch: `feat/add-due-dates`

## Feature Brief
Let a to-do carry a due date.

## Requirements
User can set and see a due date on any to-do.

## Design
A nullable due field on the record; a --due flag parses it.

## Handoff
- **Ready for:** closure on the cue.
- **Carry forward:** nothing outstanding from review.
- **Deliberately left:** recurring due dates — separate feature.

## Implementation Plan
- [ ] add --due flag and parse the date
- [ ] render the due date in the list output

## Session Log

## Decision Log
MD
# Both plan items have to be GENUINELY done, not merely gestured at. The
# assert expects reconcile to tick them, and a skill that reconciles
# honestly refuses to tick work that isn't finished — so a stub here fails
# the fixture for the right reason at the wrong time. An earlier version of
# this seed declared `--due` without parsing it and indexed t['due']
# unconditionally; claude read the code, found both defects, wrote them into
# the spec and declined to close, citing §8.1 ("not quietly done"). That was
# the skill working. The seed is what was wrong.
cat > due.py <<'PY'
import argparse
from datetime import date


def parse_due(value):
    # plan item 1: parse the date, not just capture the string
    return date.fromisoformat(value)


def parse_args(argv):
    p = argparse.ArgumentParser(prog="todo")
    p.add_argument("--due", type=parse_due, default=None)
    p.add_argument("name")
    return p.parse_args(argv)


def render_list(tasks):
    # plan item 2: render the due date, tolerating a to-do without one
    # (Design calls the field nullable)
    out = []
    for t in tasks:
        d = t.get("due")
        out.append(f"{t['name']} (due {d.isoformat()})" if d else t["name"])
    return "\n".join(out)


def add(store, argv):
    # a due date set on the command line reaches the record
    ns = parse_args(argv)
    store.append({"name": ns.name, "due": ns.due})
    return store
PY
mkdir -p tests
cat > tests/test_due.py <<'PY'
from datetime import date
import due


def test_parses_due_into_a_date():
    assert due.parse_args(["--due", "2026-08-01", "taxes"]).due == date(2026, 8, 1)


def test_renders_the_due_date():
    assert "due 2026-08-01" in due.render_list([{"name": "t", "due": date(2026, 8, 1)}])


def test_todo_without_a_due_date_still_renders():
    assert due.render_list([{"name": "milk"}]) == "milk"


def test_due_date_from_the_cli_reaches_the_record():
    assert due.add([], ["--due", "2026-08-01", "taxes"])[0]["due"] == date(2026, 8, 1)
PY
git add -A && git commit -q -m "feat: add due dates (--due flag + list rendering)"
--- assert ---
set -e
spec=specs/feature/add-due-dates.md
# Reconcile ticked the completed plan boxes — no unchecked boxes remain.
# (-- so grep doesn't read the "- [ ]" pattern as options.)
test -z "$(grep -F -- '- [ ]' "$spec" || true)"
grep -qF -- '- [x]' "$spec"
# The handoff was cleared: still exactly one block, and it no longer points at
# a next phase. A merged spec carrying a live handoff is a lie the next reader
# acts on. Portable pattern — \< is a GNU awk extension that matches nothing
# under mawk, which would make this pass vacuously.
[ "$(grep -c '^## Handoff' "$spec")" = 1 ]
git log --format='%(trailers:key=Kdevkit-Feature-Stage,valueonly=true,unfold=true)' | grep -q .
# The block was authored, not pasted: the template placeholder lists every
# legal value on one line, which would satisfy a naive negative check.
test -z "$(grep -F 'planning | dev | review' "$spec" || true)"
test -z "$(awk '/^## Handoff/{f=1;next} /^## /{f=0} f && /Phase[^a-zA-Z]*review([^a-zA-Z]|$)/' "$spec")"
# ...and it must positively say `closed`. Without this an agent can leave a
# maximally LIVE handoff (Phase: closure, Ready for: squash-merge) and pass.
awk '/^## Handoff/{f=1;next} /^## /{f=0} f && /Phase[^a-zA-Z]*closed([^a-zA-Z]|$)/' "$spec" | grep -q .
# Not a one-token relabel: close.md says replace its FIELDS, so review's
# values must be gone too, not just the Phase label flipped.
test -z "$(grep -F 'closure on the cue' "$spec" || true)"
test -z "$(grep -F 'nothing outstanding from review' "$spec" || true)"
# Deliberately-left work was resolved before clearing, not silently dropped:
# the seeded block defers "recurring due dates", so a backlog item must exist.
# Content, not just a filename: an empty file would satisfy a name-only check
# while filing nothing. Accepts a faithful retitling (repeat/schedule).
grep -rqiE 'recur|repeat|schedul' specs/backlog/ 2>/dev/null
# A closure commit exists on top of the implementation commit.
git log --no-decorate --oneline | grep -qiE 'close\(|close:|closure'
# Closure does not move the spec out of feature/ (done in place).
test -f specs/feature/add-due-dates.md
