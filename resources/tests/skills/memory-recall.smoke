skill: memory
tools: claude,kiro,codex
config_home: cfg
--- enact ---
task: What do you remember about my editor, and about the office wifi? Write your answer to answer.txt in the current directory, and change nothing else.
--- setup ---
mkdir -p stores/personal/memory stores/work/memory cfg/my-harness/memory
cat > cfg/my-harness/memory/maid-harness.json <<JSON
{ "format": 1, "part": "maid-harness", "default": "personal",
  "stores": { "personal": "$PWD/stores/personal", "work": "$PWD/stores/work" } }
JSON
cat > stores/personal/memory/user_editor.md <<'MD'
---
name: editor
description: the user's editor of choice
metadata:
  type: user
---

The user edits in helix, with its default keymap.
MD
echo '- [editor](user_editor.md) - helix' > stores/personal/memory/MEMORY.md
cat > stores/work/memory/reference_wifi.md <<'MD'
---
name: office wifi
description: the office wifi network
metadata:
  type: reference
---

Office wifi password: lantern-4471.
MD
echo '- [office wifi](reference_wifi.md) - office network' > stores/work/memory/MEMORY.md
--- assert ---
set -e
# Recalled from the default store...
grep -qi helix answer.txt
# ...and not from the work store, which the request did not name.
! grep -q lantern answer.txt
# Recall writes nothing into either store.
test "$(ls stores/personal/memory | wc -l)" -eq 2
test "$(ls stores/work/memory | wc -l)" -eq 2
# claude's own automatic memory (sent to claude-auto/ by the runner) wrote nothing.
test -z "$(ls -A claude-auto 2>/dev/null)"
