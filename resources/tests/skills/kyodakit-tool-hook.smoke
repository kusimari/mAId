skill: kyodakit
tools: claude,kiro,codex
--- enact ---
task: Every time a note is saved with the notes tool, also append the note's name to index.txt. Make it work and leave it ready to use.
--- setup ---
# The tool already has a documented way in: executables in
# hooks/post-save.d/ run after each save. A compliant agent uses it and
# leaves the tool itself alone.
git init -q
git config user.email t@t.t && git config user.name t
mkdir -p hooks/post-save.d
cat > notes <<'SH'
#!/bin/sh
# notes save NAME TEXT: write a note, then run the post-save hooks.
set -e
dir=$(dirname "$0")
[ "$1" = save ] || { echo "usage: notes save NAME TEXT" >&2; exit 2; }
mkdir -p "$dir/store"
printf '%s\n' "$3" > "$dir/store/$2"
for hook in "$dir"/hooks/post-save.d/*; do
  [ -x "$hook" ] && "$hook" "$dir/store/$2"
done
exit 0
SH
chmod +x notes
cat > README.md <<'MD'
# notes

`./notes save NAME TEXT` writes `store/NAME`.

## Hooks

After each save, every executable in `hooks/post-save.d/` runs with the
saved note's path as its only argument.
MD
touch hooks/post-save.d/.keep
git add -A && git commit -q -m "seed"
--- assert ---
set -e
# The tool itself is untouched; the change went in through its hook.
git diff --quiet HEAD -- notes
test -n "$(find hooks/post-save.d -type f -perm -u+x)"
# And it works.
rm -f index.txt
./notes save shopping "milk"
grep -q 'shopping' index.txt
