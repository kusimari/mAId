skill: kdevkit
tools: claude,kiro,codex
# The crossings log is APPEND-ONLY. A dev-loop run must add a line for the
# crossing it makes without disturbing the one already there -- that history
# is the only record of how many times a feature has gone back, so replacing
# the list destroys the thing it exists for.
--- enact ---
task: The spec for uppercase-flag is written and I've read it — start the build. Implement it and get it ready for me to look at.
--- setup ---
git init -q
git config user.email dev@example.com
git config user.name dev
mkdir -p specs/feature src
cat > AGENTS.md <<'MD'
# greet-cli — agent guide

## Build & test
- Test: `sh test.sh`
- Lint: `sh lint.sh`
MD
cat > specs/project.md <<'MD'
# Project: greet-cli

## Mission
A tiny shell greeting tool.

## Architecture
One shell script, `src/greet.sh`.

## Tech Stack
POSIX shell.

## Layout
src/greet.sh, test.sh, lint.sh.

## Testing
`sh test.sh` is load-bearing. Commands live in AGENTS.md.

## Deployment
Copied onto PATH.

## Agent Development

### kdevkit
- `code_review:`
  - `reviewer: host-native`
MD
cat > specs/feature/uppercase-flag.md <<'MD'
# Feature: uppercase flag

## Feature Brief
`greet.sh` gains a `-u` flag that upper-cases the greeting.

## Requirements
- R1. `greet.sh World` prints `Hello, World!` as today.
- R2. `greet.sh -u World` prints `HELLO, WORLD!`.

## Design
Parse `-u` as the first argument; pipe the composed line through `tr`.

## Test Strategy
`test.sh` asserts both R1 and R2.

## Handoff
- **Stage:** planning
- **Ready for:** dev, once the plan is approved.
- **Carry forward:** `tr` is available; no new dependency needed.
- **Deliberately left:** long-form `--upper` alias — `-u` only for now.

### Crossings
<!-- Append one line per crossing. Never edit or delete a line. -->
- (feature opened) → planning

## Implementation Plan
- [ ] 1 · Add `-u` parsing to `src/greet.sh`.
- [ ] 2 · Add the R2 case to `test.sh`.

## Session Log

## Decision Log
MD
cat > src/greet.sh <<'MD'
#!/bin/sh
echo "Hello, $1!"
MD
cat > test.sh <<'MD'
#!/bin/sh
set -e
out=$(sh src/greet.sh World)
[ "$out" = "Hello, World!" ] || { echo "R1 failed: $out"; exit 1; }
echo ok
MD
cat > lint.sh <<'MD'
#!/bin/sh
exit 0
MD
chmod +x src/greet.sh test.sh lint.sh
git add -A && git commit -q -m "plan(uppercase-flag): initial spec"
git checkout -q -b feat/uppercase-flag
--- assert ---
set -e
spec=specs/feature/uppercase-flag.md
# The work happened.
out=$(sh src/greet.sh -u World); [ "$out" = "HELLO, WORLD!" ]
grep -qF 'HELLO, WORLD!' test.sh
sh test.sh >/dev/null
test -z "$(grep -F -e '- [ ]' "$spec" || true)"
# The seeded crossing SURVIVED: the list was appended to, not rewritten.
grep -qF '(feature opened)' "$spec"
# ...and a new crossing was added, so there are now at least two.
n=$(awk '/^### Crossings/{c=1;next} /^#+ /{c=0} c && /^[[:space:]]*-[[:space:]]/' "$spec" | grep -c .)
test "$n" -ge 2
# Current state moved on: the stage is no longer planning, and still exists.
stage=$(awk '/^## Handoff/{f=1;next} /^#+ /{f=0} f' "$spec" | sed -n 's/^- \*\*Stage:\*\*[[:space:]]*//p' | head -1 | tr -d '[:space:]')
test -n "$stage"
printf '%s' "$stage" | grep -qE '^(dev|review)$'
# Not the template placeholder, which lists every legal value on one line.
test -z "$(grep -F 'research | planning | dev' "$spec" || true)"
# No return happened, so no RETURN line may have appeared.
test -z "$(awk '/^### Crossings/{c=1;next} /^#+ /{c=0} c' "$spec" | grep -F 'RETURN' || true)"
