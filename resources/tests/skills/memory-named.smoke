skill: memory
tools: claude,kiro,codex
config_home: cfg
--- enact ---
task: Actually do it, don't just describe. Remember this in my work store: the release checklist lives in docs/release.md.
--- setup ---
mkdir -p stores/personal/memory stores/work/memory cfg/my-harness/memory
cat > cfg/my-harness/memory/maid-harness.json <<JSON
{ "format": 1, "part": "maid-harness", "default": "personal",
  "stores": { "personal": "$PWD/stores/personal", "work": "$PWD/stores/work" } }
JSON
--- assert ---
set -e
w=stores/work/memory
# Landed in work: one memory file naming the checklist, and its index line.
new=$(ls "$w" | grep -v -x MEMORY.md)
test "$(printf '%s\n' "$new" | grep -c .)" -eq 1
grep -q 'release.md' "$w/$new"
grep -qF "]($new)" "$w/MEMORY.md"
# The default store got nothing.
test -z "$(ls -A stores/personal/memory)"
# claude's own automatic memory (sent to claude-auto/ by the runner) wrote nothing.
test -z "$(ls -A claude-auto 2>/dev/null)"
