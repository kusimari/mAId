#!/usr/bin/env bash
# Score one kyodakit trim candidate on the tight set: the tests a wording cut
# can actually move. Paid; each line runs from an isolated clone.
#   feedback (rule 4, the one test kyodakit clearly changes): claude, codex x3
#   recital (all six rules): every agent x3
#   both again under --drift
# Prints "score: <passes>/<runs>". Commit the candidate first.
set -uo pipefail
here=$(git rev-parse --show-toplevel)
iv="$here/resources/tests/isolated-verify"
log=$(mktemp)
"$iv" check kyodakit-all-feedback --kind enact --agent claude,codex --repeat 3 >>"$log" 2>&1
"$iv" check kyodakit --kind playback --repeat 3 >>"$log" 2>&1
"$iv" check kyodakit-all-feedback --kind enact --agent claude,codex --drift >>"$log" 2>&1
"$iv" check kyodakit --kind playback --drift >>"$log" 2>&1
clean=$(sed 's/\x1b\[[0-9;]*m//g' "$log")
grep -E '^(FAIL |LEAK)' <<<"$clean"
echo "score: $(grep -cE '^PASS ' <<<"$clean")/$(grep -cE '^(PASS|FAIL) ' <<<"$clean")"
rm -f "$log"
