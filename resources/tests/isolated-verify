#!/usr/bin/env bash
# Run paid skill tests from a throwaway clone, so a test that escapes its
# scratch dir writes into the clone and not into this checkout.
#
#   resources/tests/isolated-verify <check|smoke|verify> [build-tool flags...]
#   e.g. resources/tests/isolated-verify verify kyodakit --repeat 3
#
# It clones the committed HEAD (uncommitted edits are not tested), points
# every agent's skill links at the clone, runs the tests there, then puts
# the links back on whichever checkout owned them before. It reports what
# the tests changed in the clone and in this checkout, and exits non-zero
# if either changed. Run through `just resources::verify-skills-isolated`.
set -uo pipefail

here=$(git rev-parse --show-toplevel)
stage=${1:?usage: isolated-verify <check|smoke|verify> [flags...]}
shift

# Who owns the links now, so they can be restored to exactly that.
owner=$(readlink "$HOME/.claude/skills" 2>/dev/null | sed 's|/resources/content/skills$||')
# A crashed earlier run can leave links on a clone that no longer exists.
[ -n "$owner" ] && [ -d "$owner" ] || owner=$here

[ -z "$(git -C "$here" status --porcelain)" ] ||
  echo "note: uncommitted changes are not in the clone and are not tested" >&2

work=$(mktemp -d)
clone=$work/mAId
git clone -q "$here" "$clone"
# Share the build cache so the clone does not rebuild from scratch.
export CARGO_TARGET_DIR=$here/target
bt() { (cd "$1" && shift && cargo run -p build-tool --release --quiet -- "$@"); }
before=$(git -C "$here" status --porcelain; git -C "$here" for-each-ref)

restore() {
  bt "$clone" uninstall --force >/dev/null 2>&1
  bt "$owner" install --force >/dev/null 2>&1
  echo "links restored to $owner"
  local leaked=0
  if [ -n "$(git -C "$clone" status --porcelain)" ]; then
    echo "LEAK (contained) — tests changed the clone:"
    git -C "$clone" status --porcelain | sed 's/^/  /'
    leaked=1
  fi
  if [ "$before" != "$(git -C "$here" status --porcelain; git -C "$here" for-each-ref)" ]; then
    echo "LEAK — tests changed this checkout, check it by hand:"
    git -C "$here" status --porcelain | sed 's/^/  /'
    leaked=1
  fi
  rm -rf "$work"
  [ "$leaked" = 0 ] || exit 3
}
trap restore EXIT

bt "$clone" install --force >/dev/null
bt "$clone" "$stage" "$@"
